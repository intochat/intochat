<?xml version="1.0" encoding="utf-8"?>
<!-- Committed restore sources: nuget.org only. DigitalBrain and DigitalBrain.* resolve from nuget.org alone (D-01).
     Local pre-release feeds stay in out-of-repo configs passed with -p:RestoreConfigFile; never add them here. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="DigitalBrain" />
      <package pattern="DigitalBrain.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
