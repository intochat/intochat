<?xml version="1.0" encoding="utf-8"?>
<!-- Committed restore sources: nuget.org only. The DigitalBrain framework is framework/, built by project reference;
     its packages come from `dotnet pack framework/DigitalBrain.slnx`, never from a feed here. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
