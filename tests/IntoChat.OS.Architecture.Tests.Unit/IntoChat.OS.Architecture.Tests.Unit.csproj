<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <ArchitectureProject Include="../../src/IntoChat.OS/*.csproj;../../src/IntoChat.OS.UI/*.csproj;../../src/IntoChat.OS.Apps/*.csproj;../../src/IntoChat.OS.AppHost/*.csproj;../../src/IntoChat.OS.LocalSetup/*.csproj;../../src/IntoChat.OS.Kernel/*.csproj;../../src/IntoChat.OS.Host/*.csproj;../../src/Modules/*/*.csproj;../../src/Modules/*/Contracts/*.csproj" />
    <ProjectReference Include="@(ArchitectureProject)" />
  </ItemGroup>
  <Target Name="WriteArchitectureAssemblies" AfterTargets="Build">
    <WriteLinesToFile File="$(OutDir)ArchitectureAssemblies.txt"
                      Lines="@(ArchitectureProject->'%(Filename)');DigitalBrain" Overwrite="true" />
  </Target>
</Project>
