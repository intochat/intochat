<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The reference brain boots the real AppHost; this project touches the product, so it is
         never packaged. The publishable harness lives in DigitalBrain.Testing.E2E. -->
    <IsPackable>false</IsPackable>
    <RootNamespace>DigitalBrain.Testing.Reference</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="DigitalBrain.Testing.E2E" />
    <Using Include="Xunit" />
    <Using Include="DigitalBrain.Testing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="Npgsql" />
    <ProjectReference Include="../DigitalBrain.Testing.E2E/DigitalBrain.Testing.E2E.csproj" />
    <ProjectReference Include="../../DigitalBrain/AppHost/DigitalBrain.AppHost/DigitalBrain.AppHost.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="../../DigitalBrain/OS/DigitalBrain.OS/DigitalBrain.OS.csproj" />
  </ItemGroup>
</Project>
