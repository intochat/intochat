<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
    <ProjectReference Include="../IntoChat.OS.Testing/IntoChat.OS.Testing.csproj" />
    <!-- RetiredKeyFacts reads the retired table of LegacyConfigurationGuard. -->
    <ProjectReference Include="../../IntoChat.OS.Aspire/IntoChat.OS.ServiceDefaults/IntoChat.OS.ServiceDefaults.csproj" />
    <ArchitectureProject Include="../../IntoChat.OS/**/*.csproj;../../IntoChat.OS.AppHost/**/*.csproj;../../IntoChat.OS.Client/**/*.csproj;../../IntoChat.OS.Framework/**/*.csproj;../../IntoChat.OS.Connections/**/*.csproj;../../IntoChat.OS.Sdk/**/*.csproj;../../IntoChat.OS.Mcp/**/*.csproj;../../IntoChat.OS.Kernel/**/*.csproj;../../IntoChat.OS.Authority/**/*.csproj;../../IntoChat.OS.Trust/**/*.csproj;../../IntoChat.OS.Modules/**/*.csproj"
                         Exclude="../../**/tests/**;../../**/*.Generators.csproj;../../**/*.Generators.Tests.*/**;../../**/*.Tests.csproj;../../**/*.Tests.*.csproj;../../**/*.Testing/**;../../**/*.Aspire.Hosting/**;../../**/*.Deployment/**;../../**/*.Sandbox/**" />
    <ProjectReference Include="@(ArchitectureProject)" />
    <None Include="NonExportableStates.json;ExportedStateBaseline.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="TestTierBaseline.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="SwallowBaseline.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <None Include="CollectionCompatibilitySamples.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- DigitalBrain (the core package, CORE-02) is the lowest kernel layer, so the production graph loads it with the projects. -->
  <Target Name="WriteArchitectureAssemblies" AfterTargets="Build">
    <WriteLinesToFile File="$(OutDir)ArchitectureAssemblies.txt"
                      Lines="@(ArchitectureProject->'%(Filename)');DigitalBrain" Overwrite="true" />
  </Target>
</Project>
