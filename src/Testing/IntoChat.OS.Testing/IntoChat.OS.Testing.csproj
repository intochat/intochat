<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageTags>testing;orleans;aspire;intochat-os</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>One harness for every IntoChat.OS test: the TestBrain builder, targets that run the product recipe, signal probes, behavior runs, bounded waits and a fake model endpoint.</Description>
