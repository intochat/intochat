<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Description>Test-only: runs one fact body on TestOS and on the in-process silo host (SiloHost.Local) for migrated plain neurons.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DigitalBrain.Testing" />
