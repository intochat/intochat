    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.Web" />
  </ItemGroup>
  <ItemGroup><Protobuf Include="Neurons/neurons.proto" GrpcServices="Both" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../../DigitalBrain.Framework/DigitalBrain.Framework/DigitalBrain.Framework.csproj" /><ProjectReference Include="../DigitalBrain.Authority.Contracts/DigitalBrain.Authority.Contracts.csproj" /></ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DigitalBrain.Authority.Tests.Integration" />
