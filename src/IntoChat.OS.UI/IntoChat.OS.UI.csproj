<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <RootNamespace>IntoChat.OS.UI</RootNamespace>
    <Description>Fluent Reactor UI kit, DDD Decision and AggregateScreen command binding, and Accordant-inspired AggregateExplorer for IntoChat OS.</Description>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DigitalBrain" PrivateAssets="none" />
    <PackageReference Include="DigitalBrain.UI" PrivateAssets="none" />
    <InternalsVisibleTo Include="IntoChat.OS.Tests.Unit" />
    <InternalsVisibleTo Include="IntoChat.OS.Tests.Integration" />
    <InternalsVisibleTo Include="IntoChat.OS.Architecture.Tests.Unit" />
  </ItemGroup>
</Project>
