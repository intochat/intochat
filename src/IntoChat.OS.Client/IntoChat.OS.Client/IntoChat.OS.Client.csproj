<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Connects single-file C# apps to a IntoChat.OS cluster: neuron calls and live signal subscriptions.</Description>
    <RootNamespace>IntoChat.OS.Client</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
<PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../../IntoChat.OS/IntoChat.OS.csproj" /></ItemGroup>
  <!-- The runtime protocol records also cross grain calls inside the silo. -->
  <ItemGroup><PackageReference Include="Microsoft.Orleans.Sdk" PrivateAssets="all" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="IntoChat.OS.Client.Tests.Unit" /></ItemGroup>
</Project>
