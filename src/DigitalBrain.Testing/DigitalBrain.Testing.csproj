<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <RootNamespace>DigitalBrain.Testing</RootNamespace>
    <PackageId>DigitalBrain.Testing</PackageId>
    <Description>Fakes, assertion helpers and the in-process host entry point for testing DigitalBrain neurons and modules.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DigitalBrain/DigitalBrain.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
