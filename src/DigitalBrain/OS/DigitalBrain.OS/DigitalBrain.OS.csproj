<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Local runs write grain state under this folder. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);.digitalbrain/**</DefaultItemExcludes>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
    <Description>The operating system: the named module composition, the OS apps, and the host that runs them.</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../Apps/**/*" LogicalName="DigitalBrain.OS.Apps/%(RecursiveDir)%(Filename)%(Extension)" Link="Apps/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IntoChat.Tests.E2E" />
    <InternalsVisibleTo Include="IntoChat.Tests.Unit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Aspire/DigitalBrain.Aspire.Server/DigitalBrain.Aspire.Server.csproj" />
    <ProjectReference Include="../../Sdk/DigitalBrain.Sdk/DigitalBrain.Sdk.csproj" />
    <ProjectReference Include="../../Platform/DigitalBrain.Platform/DigitalBrain.Platform.csproj" />
    <ProjectReference Include="../../../IntoChat/IntoChat.ServiceDefaults/IntoChat.ServiceDefaults.csproj" />
    <ProjectReference Include="../../../IntoChat/IntoChat.Apps/IntoChat.Apps.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The OS is the composition of every module in the repo; OsCatalog names them in code
         and the compiler checks the two agree. Hosting, deployment, contracts, testing and
         sandbox projects ride along with their module or belong to other rings. -->
    <ProjectReference Include="../../../Modules/**/DigitalBrain.Modules.*.csproj"
                      Exclude="../../../Modules/**/tests/**;
                               ../../../Modules/**/DigitalBrain.Modules.*.Aspire.Hosting.csproj;
                               ../../../Modules/**/DigitalBrain.Modules.*.Deployment.csproj;
                               ../../../Modules/**/DigitalBrain.Modules.*.Testing.csproj;
                               ../../../Modules/**/DigitalBrain.Modules.*.Contracts.csproj;
                               ../../../Modules/**/DigitalBrain.Modules.*.Sandbox.csproj" />
  </ItemGroup>
</Project>
