<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Kernel module contracts: names, enforcement, data, and script-facing accounts.</Description>
    <RootNamespace>DigitalBrain.Contracts</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Sdk" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Orleans.Core.Abstractions" />
    <!-- Module.Configure binds ISiloBuilder, which Orleans keeps in Orleans.Runtime (pulled in
         by Orleans.Server). The module declaration lives in this ring, so this ring needs it. -->
    <PackageReference Include="Microsoft.Orleans.Runtime" />
    <ProjectReference Include="../DigitalBrain/DigitalBrain.csproj" />
  </ItemGroup>
</Project>
