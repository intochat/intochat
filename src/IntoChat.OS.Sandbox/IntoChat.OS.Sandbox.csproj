<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Description>Isolated container worker executing compiled user apps via IntoChatClient.</Description>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerRepository>intochat-os-sandbox</ContainerRepository>
    <ContainerImageTag>local</ContainerImageTag>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:11.0.0</ContainerBaseImage>
    <ContainerUser>app</ContainerUser>
    <LocalRegistry>Docker</LocalRegistry>
  </PropertyGroup>
  <ItemGroup>
    <ContainerPort Include="8080" Type="tcp" />
    <ContainerEnvironmentVariable Include="ASPNETCORE_ENVIRONMENT" Value="Production" />
    <ContainerEnvironmentVariable Include="ASPNETCORE_URLS" Value="http://+:8080" />
    <ContainerEnvironmentVariable Include="DOTNET_EnableDiagnostics" Value="0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <ProjectReference Include="..\..\framework\src\DigitalBrain.Runtime.Synapses\DigitalBrain.Runtime.Synapses.csproj" />
    <ProjectReference Include="..\IntoChat.OS\IntoChat.OS.csproj" />
    <ProjectReference Include="..\IntoChat.OS.UI\IntoChat.OS.UI.csproj" />
    <!-- The contracts sandboxed code may reach through the brain client: interfaces and records only, no module implementation. -->
    <ProjectReference Include="..\Modules\AI\Contracts\IntoChat.OS.Modules.AI.Contracts.csproj" />
    <ProjectReference Include="..\Modules\Catalog\Contracts\IntoChat.OS.Modules.Catalog.Contracts.csproj" />
    <ProjectReference Include="..\Modules\Roslyn\Contracts\IntoChat.OS.Modules.Roslyn.Contracts.csproj" />
    <InternalsVisibleTo Include="IntoChat.OS.Tests.Unit" />
    <InternalsVisibleTo Include="IntoChat.OS.Tests.Integration" />
  </ItemGroup>
</Project>
