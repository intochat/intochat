<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>The kernel composition (06-02, R4-12): kernel grains, the Orleans host wiring, the runtime cluster store and the transitional legacy adapters between the os Framework and DigitalBrain.Runtime.Orleans. Also carries the legacy cluster neuron until 06-03.</Description>
    <RootNamespace>IntoChat.OS.Kernel.Composition</RootNamespace>
    <NoWarn>$(NoWarn);ORLEANSEXP005</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IntoChat.OS.Kernel.Composition.Tests.Integration" />
    <InternalsVisibleTo Include="IntoChat.OS.Kernel.Tests.E2E" />
    <InternalsVisibleTo Include="IntoChat.OS.Modules.Microsoft.Orleans.Tests.Unit" />
    <!-- The cloud topology (Topology=cloud): only the composition references the Azure runtime package (03-12). -->
    <PackageReference Include="DigitalBrain.Runtime.Orleans" />
    <PackageReference Include="DigitalBrain.Runtime.Orleans.Azure" />
    <PackageReference Include="DigitalBrain.Runtime.Http" />
    <PackageReference Include="DigitalBrain.Capabilities.Compute" />
    <PackageReference Include="DigitalBrain.Capabilities.Connections" />
    <PackageReference Include="DigitalBrain.Identity.Local" />
    <ProjectReference Include="../../IntoChat.OS.Modules/Microsoft/Orleans/Contracts/IntoChat.OS.Modules.Microsoft.Orleans.Contracts/IntoChat.OS.Modules.Microsoft.Orleans.Contracts.csproj" />
    <ProjectReference Include="../../IntoChat.OS/Hosting/IntoChat.OS.Framework/IntoChat.OS.Framework.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Modules/IntoChat.OS/Identity/src/IntoChat.OS.Modules.Identity/IntoChat.OS.Modules.Identity.csproj" />
    
    <!-- The edge encoding (RuntimeProtocol.Json) legacy signals are journaled in. -->
    <PackageReference Include="DigitalBrain.Client" />
    <PackageReference Include="DigitalBrain.Runtime.Synapses" />
  </ItemGroup>
</Project>
