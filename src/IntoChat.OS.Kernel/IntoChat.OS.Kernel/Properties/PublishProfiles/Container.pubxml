<?xml version="1.0" encoding="utf-8"?>
<!-- Used only by release.yml PublishContainer — keeps Container* props out of plain CI builds.
     The image enables the OS catalog; configuration may disable modules.
     Managed identity, storage and Key Vault are configuration, not code: set AZURE_CLIENT_ID, IntoChatOS__Topology=cloud,
     IntoChatOS__Cloud__Storage and IntoChatOS__Cloud__KeyVault on the container app, or provide them through the hosted profile. -->
<Project>
  <PropertyGroup>
    <PublishProtocol>Container</PublishProtocol>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerRegistry>ghcr.io</ContainerRegistry>
    <ContainerRepository>intochat/os</ContainerRepository>
    <ContainerImageTags>$(VersionPrefix);latest</ContainerImageTags>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:11.0.0-rc.1</ContainerBaseImage>
    <ContainerRuntimeIdentifier>linux-x64</ContainerRuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ContainerPort Include="8080" Type="tcp" />
    <!-- The features folder the project publishes beside the silo (AppsOptions.Features). -->
    <ContainerEnvironmentVariable Include="IntoChatOS__Modules__apps__Options__Features" Value="features" />
  </ItemGroup>
</Project>
