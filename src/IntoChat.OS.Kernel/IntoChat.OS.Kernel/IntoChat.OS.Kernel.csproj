<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Local runs write grain state under this folder. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);.intochat-os/**</DefaultItemExcludes>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>IntoChat.OS.Kernel</PackageId>
    <Description>The operating system: the named module composition, the OS apps, and the host that runs them.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Ship OS apps with the composition package as runtime sources, never host Compile items.
         NuGet preserves features/os/... in a consumer's build and publish output. -->
    <None Include="../../../features/os/**/*" Exclude="../../../features/os/**/bin/**;../../../features/os/**/obj/**"
          LinkBase="features/os" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest"
          Pack="true" PackagePath="contentFiles/any/$(TargetFramework)/features/os/%(RecursiveDir)%(Filename)%(Extension)"
          PackageCopyToOutput="true" PackageFlatten="false" />
    <!-- Other repository publishers belong to this host, not to the reusable OS package. -->
    <None Include="../../../features/**/*" Exclude="../../../features/os/**;../../../features/**/bin/**;../../../features/**/obj/**"
          LinkBase="features" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IntoChat.OS.Kernel.Tests.Unit" />
    <InternalsVisibleTo Include="IntoChat.OS.Kernel.Tests.Integration" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../IntoChat.OS.Apps/IntoChat.OS.Apps.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Aspire/IntoChat.OS.Aspire.Server/IntoChat.OS.Aspire.Server.csproj" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Core first-party OS modules hosted in this repository. -->
    <ProjectReference Include="../../IntoChat.OS.Modules/**/IntoChat.OS.Modules.*.csproj"
                      Exclude="../../IntoChat.OS.Modules/**/tests/**;
                               ../../IntoChat.OS.Modules/**/IntoChat.OS.Modules.*.Aspire.Hosting.csproj;
                               ../../IntoChat.OS.Modules/**/IntoChat.OS.Modules.*.Testing.csproj;
                               ../../IntoChat.OS.Modules/**/IntoChat.OS.Modules.*.Contracts.csproj;
                               ../../IntoChat.OS.Modules/**/IntoChat.OS.Modules.*.Sandbox.csproj" />
    <!-- External modules from IntoChat.Modules consumed via NuGet. -->
    <ProjectReference Include="../../IntoChat.OS.Modules/ArtCraft/ArtCraft/src/IntoChat.OS.Modules.ArtCraft/IntoChat.OS.Modules.ArtCraft.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Modules/ClickHouse/src/IntoChat.OS.Modules.ClickHouse/IntoChat.OS.Modules.ClickHouse.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Modules/Google/Auth/src/IntoChat.OS.Modules.Google.Auth/IntoChat.OS.Modules.Google.Auth.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Modules/Google/Drive/src/IntoChat.OS.Modules.Google.Drive/IntoChat.OS.Modules.Google.Drive.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Modules/Google/Gmail/src/IntoChat.OS.Modules.Google.Gmail/IntoChat.OS.Modules.Google.Gmail.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Modules/LocalDisk/src/IntoChat.OS.Modules.LocalDisk/IntoChat.OS.Modules.LocalDisk.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Modules/ModelContextProtocol/Mcp/src/IntoChat.OS.Modules.Mcp/IntoChat.OS.Modules.Mcp.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Modules/Microsoft/Azure/src/IntoChat.OS.Modules.Microsoft.Azure/IntoChat.OS.Modules.Microsoft.Azure.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Modules/Microsoft/GitHub/src/IntoChat.OS.Modules.Microsoft.GitHub/IntoChat.OS.Modules.Microsoft.GitHub.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Modules/Microsoft/Orleans/Contracts/IntoChat.OS.Modules.Microsoft.Orleans.Contracts/IntoChat.OS.Modules.Microsoft.Orleans.Contracts.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Modules/Microsoft/Playwright/src/IntoChat.OS.Modules.Microsoft.Playwright/IntoChat.OS.Modules.Microsoft.Playwright.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Modules/Microsoft/Roslyn/src/IntoChat.OS.Modules.Microsoft.Roslyn/IntoChat.OS.Modules.Microsoft.Roslyn.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Modules/Microsoft/Windows/src/IntoChat.OS.Modules.Microsoft.Windows/IntoChat.OS.Modules.Microsoft.Windows.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Modules/Postgres/src/IntoChat.OS.Modules.Postgres/IntoChat.OS.Modules.Postgres.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Modules/Qdrant/src/IntoChat.OS.Modules.Qdrant/IntoChat.OS.Modules.Qdrant.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Modules/Salesforce/src/IntoChat.OS.Modules.Salesforce/IntoChat.OS.Modules.Salesforce.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Modules/Supabase/src/IntoChat.OS.Modules.Supabase/IntoChat.OS.Modules.Supabase.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Modules/Time/src/IntoChat.OS.Modules.Time/IntoChat.OS.Modules.Time.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Modules/IntoChat.OS/Tools/src/IntoChat.OS.Modules.Tools/IntoChat.OS.Modules.Tools.csproj" />
    <!-- Cloud modules. Each declares LoadsUnder; the host skips a module whose LoadsUnder returns false. -->
    <ProjectReference Include="../../IntoChat.Cloud/Modules/Auth/src/IntoChat.Cloud.Auth/IntoChat.Cloud.Auth.csproj" />
    <ProjectReference Include="../../IntoChat.Cloud/Modules/Blob/src/IntoChat.Cloud.Blob/IntoChat.Cloud.Blob.csproj" />
    <ProjectReference Include="../../IntoChat.Cloud/Modules/Circle/src/IntoChat.Cloud.Circle.Server/IntoChat.Cloud.Circle.Server.csproj" />
    <ProjectReference Include="../../IntoChat.Cloud/Modules/Hosting/src/IntoChat.Cloud.Hosting/IntoChat.Cloud.Hosting.csproj" />
    <ProjectReference Include="../../IntoChat.Cloud/Modules/Lobby/src/IntoChat.Cloud.Lobby/IntoChat.Cloud.Lobby.csproj" />
    <ProjectReference Include="../../IntoChat.Cloud/Modules/Localization/src/IntoChat.Cloud.Localization/IntoChat.Cloud.Localization.csproj" />
    <ProjectReference Include="../../IntoChat.Cloud/Modules/Mail/src/IntoChat.Cloud.Mail/IntoChat.Cloud.Mail.csproj" />
    <ProjectReference Include="../../IntoChat.Cloud/Modules/Organisations/src/IntoChat.Cloud.Organisations/IntoChat.Cloud.Organisations.csproj" />
  </ItemGroup>
</Project>
