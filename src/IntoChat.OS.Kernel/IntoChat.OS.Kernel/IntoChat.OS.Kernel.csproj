<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Local runs write grain state under this folder. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);.intochat-os/**</DefaultItemExcludes>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>IntoChat.OS.Kernel</PackageId>
    <Description>The operating system: the named module composition, the OS apps, and the host that runs them.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Ship OS apps with the composition package as runtime sources, never host Compile items.
         NuGet preserves features/os/... in a consumer's build and publish output. -->
    <None Include="../../../features/os/**/*" Exclude="../../../features/os/**/bin/**;../../../features/os/**/obj/**"
          LinkBase="features/os" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest"
          Pack="true" PackagePath="contentFiles/any/$(TargetFramework)/features/os/%(RecursiveDir)%(Filename)%(Extension)"
          PackageCopyToOutput="true" PackageFlatten="false" />
    <!-- Other repository publishers belong to this host, not to the reusable OS package. -->
    <None Include="../../../features/**/*" Exclude="../../../features/os/**;../../../features/**/bin/**;../../../features/**/obj/**"
          LinkBase="features" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IntoChat.OS.Kernel.Tests.E2E" />
    <InternalsVisibleTo Include="IntoChat.OS.Kernel.Tests.Unit" />
    <InternalsVisibleTo Include="IntoChat.OS.Kernel.Tests.Integration" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../IntoChat.OS.Aspire/IntoChat.OS.Aspire.Server/IntoChat.OS.Aspire.Server.csproj" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <ProjectReference Include="../../IntoChat.OS.Authority/IntoChat.OS.Authority/IntoChat.OS.Authority.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The OS is the composition of the portable modules in the repo; OperatingSystemModules names them in
         code and the compiler checks the two agree. Hosting, contracts, testing and sandbox projects
         ride along with their module or belong to other rings. The Windows edge is referenced below, explicitly. -->
    <ProjectReference Include="../../IntoChat.OS.Modules/**/IntoChat.OS.Modules.*.csproj"
                      Exclude="../../IntoChat.OS.Modules/**/tests/**;
                               ../../IntoChat.OS.Modules/**/IntoChat.OS.Modules.*.Aspire.Hosting.csproj;
                               ../../IntoChat.OS.Modules/**/IntoChat.OS.Modules.*.Testing.csproj;
                               ../../IntoChat.OS.Modules/**/IntoChat.OS.Modules.*.Contracts.csproj;
                               ../../IntoChat.OS.Modules/**/IntoChat.OS.Modules.*.Sandbox.csproj;
                               ../../IntoChat.OS.Modules/Microsoft/Windows/**;
                               ../../IntoChat.OS.Modules/Microsoft/Azure/**" />
    <!-- The Azure module (OperatingSystemModules) is the cloud face of the OS and backs the install command. -->
    <ProjectReference Include="../../IntoChat.OS.Modules/Microsoft/Azure/src/IntoChat.OS.Modules.Microsoft.Azure/IntoChat.OS.Modules.Microsoft.Azure.csproj" />
    <!-- The Windows edge (OperatingSystemModules.WithWindowsEdge), composed only by a host running on Windows. -->
    <ProjectReference Include="../../IntoChat.OS.Modules/Microsoft/Windows/src/IntoChat.OS.Modules.Microsoft.Windows/IntoChat.OS.Modules.Microsoft.Windows.csproj" />
    <!-- Cloud modules. Each declares LoadsUnder and the host skips them unless Topology=cloud. -->
    <ProjectReference Include="../../IntoChat.Cloud/Modules/Auth/src/IntoChat.Cloud.Auth/IntoChat.Cloud.Auth.csproj" />
    <ProjectReference Include="../../IntoChat.Cloud/Modules/Circle/src/IntoChat.Cloud.Circle.Server/IntoChat.Cloud.Circle.Server.csproj" />
  </ItemGroup>
</Project>
