<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Local runs write grain state under this folder. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);.intochat-os/**</DefaultItemExcludes>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>IntoChat.OS.Kernel</PackageId>
    <Description>The operating system: the named module composition, the OS apps, and the host that runs them.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Ship OS apps with the composition package as runtime sources, never host Compile items.
         NuGet preserves features/os/... in a consumer's build and publish output. -->
    <None Include="../../../features/os/**/*" Exclude="../../../features/os/**/bin/**;../../../features/os/**/obj/**"
          LinkBase="features/os" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest"
          Pack="true" PackagePath="contentFiles/any/$(TargetFramework)/features/os/%(RecursiveDir)%(Filename)%(Extension)"
          PackageCopyToOutput="true" PackageFlatten="false" />
    <!-- Other repository publishers belong to this host, not to the reusable OS package. -->
    <None Include="../../../features/**/*" Exclude="../../../features/os/**;../../../features/**/bin/**;../../../features/**/obj/**"
          LinkBase="features" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IntoChat.OS.Kernel.Tests.Unit" />
    <InternalsVisibleTo Include="IntoChat.OS.Kernel.Tests.Integration" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../IntoChat.OS.Aspire/IntoChat.OS.Aspire.Server/IntoChat.OS.Aspire.Server.csproj" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Core first-party OS modules hosted in this repository. -->
    <ProjectReference Include="../../IntoChat.OS.Modules/**/IntoChat.OS.Modules.*.csproj"
                      Exclude="../../IntoChat.OS.Modules/**/tests/**;
                               ../../IntoChat.OS.Modules/**/IntoChat.OS.Modules.*.Aspire.Hosting.csproj;
                               ../../IntoChat.OS.Modules/**/IntoChat.OS.Modules.*.Testing.csproj;
                               ../../IntoChat.OS.Modules/**/IntoChat.OS.Modules.*.Contracts.csproj;
                               ../../IntoChat.OS.Modules/**/IntoChat.OS.Modules.*.Sandbox.csproj" />
    <!-- External modules from IntoChat.Modules consumed via NuGet. -->
    <PackageReference Include="IntoChat.OS.Modules.AI" />
    <PackageReference Include="IntoChat.OS.Modules.ArtCraft" />
    <PackageReference Include="IntoChat.OS.Modules.ClickHouse" />
    <PackageReference Include="IntoChat.OS.Modules.Flutter" />
    <PackageReference Include="IntoChat.OS.Modules.Google.Auth" />
    <PackageReference Include="IntoChat.OS.Modules.Google.Drive" />
    <PackageReference Include="IntoChat.OS.Modules.Google.Gmail" />
    <PackageReference Include="IntoChat.OS.Modules.LocalDisk" />
    <PackageReference Include="IntoChat.OS.Modules.Mcp" />
    <PackageReference Include="IntoChat.OS.Modules.Microsoft.Aspire" />
    <PackageReference Include="IntoChat.OS.Modules.Microsoft.Azure" />
    <PackageReference Include="IntoChat.OS.Modules.Microsoft.CSharp" />
    <PackageReference Include="IntoChat.OS.Modules.Microsoft.GitHub" />
    <PackageReference Include="IntoChat.OS.Modules.Microsoft.Orleans.Contracts" />
    <PackageReference Include="IntoChat.OS.Modules.Microsoft.Playwright" />
    <PackageReference Include="IntoChat.OS.Modules.Microsoft.Roslyn" />
    <PackageReference Include="IntoChat.OS.Modules.Microsoft.Windows" />
    <PackageReference Include="IntoChat.OS.Modules.Postgres" />
    <PackageReference Include="IntoChat.OS.Modules.Qdrant" />
    <PackageReference Include="IntoChat.OS.Modules.Salesforce" />
    <PackageReference Include="IntoChat.OS.Modules.Supabase" />
    <PackageReference Include="IntoChat.OS.Modules.Time" />
    <PackageReference Include="IntoChat.OS.Modules.Tools" />
    <!-- Cloud modules. Each declares LoadsUnder; the host skips a module whose LoadsUnder returns false. -->
    <ProjectReference Include="../../IntoChat.Cloud/Modules/Auth/src/IntoChat.Cloud.Auth/IntoChat.Cloud.Auth.csproj" />
    <ProjectReference Include="../../IntoChat.Cloud/Modules/Blob/src/IntoChat.Cloud.Blob/IntoChat.Cloud.Blob.csproj" />
    <ProjectReference Include="../../IntoChat.Cloud/Modules/Circle/src/IntoChat.Cloud.Circle.Server/IntoChat.Cloud.Circle.Server.csproj" />
    <ProjectReference Include="../../IntoChat.Cloud/Modules/Hosting/src/IntoChat.Cloud.Hosting/IntoChat.Cloud.Hosting.csproj" />
    <ProjectReference Include="../../IntoChat.Cloud/Modules/Lobby/src/IntoChat.Cloud.Lobby/IntoChat.Cloud.Lobby.csproj" />
    <ProjectReference Include="../../IntoChat.Cloud/Modules/Localization/src/IntoChat.Cloud.Localization/IntoChat.Cloud.Localization.csproj" />
    <ProjectReference Include="../../IntoChat.Cloud/Modules/Mail/src/IntoChat.Cloud.Mail/IntoChat.Cloud.Mail.csproj" />
    <ProjectReference Include="../../IntoChat.Cloud/Modules/Organisations/src/IntoChat.Cloud.Organisations/IntoChat.Cloud.Organisations.csproj" />
  </ItemGroup>
</Project>
