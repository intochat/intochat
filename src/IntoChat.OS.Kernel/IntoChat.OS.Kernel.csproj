<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);.intochat-os/**;**/.last_build_id</DefaultItemExcludes>
    <NoWarn>$(NoWarn);CA2007;CS1591;ORLEANSEXP005</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>IntoChat.OS.Kernel</PackageId>
    <Description>The operating system: the named module composition, the OS apps, in-process MCP, and the host that runs them.</Description>
    <PublishAot Condition="'$(IntoChatOSAot)' == 'true'">true</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault Condition="'$(IntoChatOSAot)' == 'true'">true</JsonSerializerIsReflectionEnabledByDefault>
    <IlcOptimizationPreference Condition="'$(IntoChatOSAot)' == 'true'">Speed</IlcOptimizationPreference>
    <IlcFoldIdenticalMethodBodies Condition="'$(IntoChatOSAot)' == 'true'">false</IlcFoldIdenticalMethodBodies>
    <StripSymbols Condition="'$(IntoChatOSAot)' == 'true'">true</StripSymbols>
    <TreatWarningsAsErrors Condition="'$(IntoChatOSAot)' == 'true'">false</TreatWarningsAsErrors>
    <DefineConstants Condition="'$(IntoChatOSAot)' == 'true'">$(DefineConstants);INTOCHAT_OS_AOT</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(IntoChatOSAot)' == 'true'">
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Azure.Data.Tables" />
    <PackageReference Include="Aspire.Azure.Storage.Blobs" />
    <ProjectReference Include="../../framework/src/DigitalBrain/DigitalBrain.csproj" />
    <ProjectReference Include="../../framework/src/DigitalBrain.Runtime.Http/DigitalBrain.Runtime.Http.csproj" />
    <ProjectReference Include="../../framework/src/DigitalBrain.Runtime.Orleans/DigitalBrain.Runtime.Orleans.csproj" />
    <ProjectReference Include="../../framework/src/DigitalBrain.Runtime.Orleans.Azure/DigitalBrain.Runtime.Orleans.Azure.csproj" />
    <ProjectReference Include="../../framework/src/DigitalBrain.Simulation/DigitalBrain.Simulation.csproj" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.Web" />
    <PackageReference Include="Microsoft.Orleans.Clustering.AzureStorage" />
    <PackageReference Include="Microsoft.Agents.AI.DevUI" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.OpenAI" />
    <PackageReference Include="Microsoft.Orleans.Dashboard" />
    <PackageReference Include="Microsoft.Orleans.Sdk" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Orleans.Serialization.SystemTextJson" />
    <PackageReference Include="Microsoft.Orleans.Server" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../IntoChat.OS/IntoChat.OS.csproj" />
    <ProjectReference Include="../IntoChat.OS.Host/IntoChat.OS.Host.csproj" />
    <ProjectReference Include="../Modules/Identity/Contracts/IntoChat.OS.Modules.Identity.Contracts.csproj" />
    <ProjectReference Include="../Modules/Identity/IntoChat.OS.Modules.Identity.csproj" />
    <ProjectReference Include="../IntoChat.OS.Apps/IntoChat.OS.Apps.csproj" />
    <ProjectReference Include="../Modules/AI/IntoChat.OS.Modules.AI.csproj" />
    <ProjectReference Include="../Modules/Plugins/IntoChat.OS.Modules.Plugins.csproj" />
    <ProjectReference Include="../Modules/Infrastructure/IntoChat.OS.Modules.Infrastructure.csproj" />
    <ProjectReference Include="../Components/Aspire/IntoChat.Aspire.csproj" />
    <ProjectReference Include="../Modules/Catalog/IntoChat.OS.Modules.Catalog.csproj" />
    <ProjectReference Include="../Modules/Devices/IntoChat.OS.Modules.Devices.csproj" />
    <ProjectReference Include="../Modules/Roslyn/IntoChat.OS.Modules.Roslyn.csproj" Condition="'$(IntoChatOSAot)' != 'true'" />
    <ProjectReference Include="../IntoChat.OS.Contracts/IntoChat.OS.Contracts.csproj" />
    <ProjectReference Include="../Modules/Shell/IntoChat.OS.Modules.Shell.csproj" />
    <ProjectReference Include="../Modules/UI/IntoChat.OS.Modules.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IntoChat.OS.Tests.Unit" />
    <InternalsVisibleTo Include="IntoChat.OS.Tests.Integration" />
    <InternalsVisibleTo Include="IntoChat.OS.Tests.E2E" />
    <InternalsVisibleTo Include="IntoChat.OS.Architecture.Tests.Unit" />
  </ItemGroup>
  <Target Name="IncludeKernelDepsJsonInPublish" DependsOnTargets="GenerateBuildDependencyFile" BeforeTargets="GetCopyToPublishDirectoryItems">
    <ItemGroup Condition="Exists('$(ProjectDepsFilePath)')">
      <AllPublishItemsFullPathWithTargetPath Include="$(ProjectDepsFilePath)" TargetPath="$(ProjectDepsFileName)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Protobuf Include="Platform/neurons.proto" GrpcServices="Both" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../deploy/Pulumi.yaml" LogicalName="IntoChat.OS.Kernel.Install.Assets.Pulumi.yaml" Link="Install/Assets/Pulumi.yaml" />
    <EmbeddedResource Include="../../deploy/Pulumi.stack.yaml" LogicalName="IntoChat.OS.Kernel.Install.Assets.Pulumi.stack.yaml" Link="Install/Assets/Pulumi.stack.yaml" />
    <EmbeddedResource Include="../../deploy/command-stop.yaml" LogicalName="IntoChat.OS.Kernel.Install.Assets.command-stop.yaml" Link="Install/Assets/command-stop.yaml" />
    <EmbeddedResource Include="../../deploy/command-start.yaml" LogicalName="IntoChat.OS.Kernel.Install.Assets.command-start.yaml" Link="Install/Assets/command-start.yaml" />
    <EmbeddedResource Include="../../scripts/az-retry.sh" LogicalName="IntoChat.OS.Kernel.Install.Assets.az-retry.sh" Link="Install/Assets/az-retry.sh" />
  </ItemGroup>
</Project>
