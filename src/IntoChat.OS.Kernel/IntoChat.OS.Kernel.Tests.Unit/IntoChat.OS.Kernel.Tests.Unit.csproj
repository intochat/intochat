    <ProjectReference Include="../IntoChat.OS.Kernel/IntoChat.OS.Kernel.csproj" />
    <ProjectReference Include="../IntoChat.OS.Kernel.Testing/IntoChat.OS.Kernel.Testing.csproj" />
    <Using Include="IntoChat.OS.Kernel.Testing" />
    <ProjectReference Include="../../IntoChat.OS.AppHost/IntoChat.OS.AppHost.csproj" IsAspireProjectResource="false" Aliases="AppHost" />
  </ItemGroup>
  <Target Name="CopyKitTests" AfterTargets="Build">
    <MSBuild Projects="@(KitTestProject)" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="KitTestAssembly" />
    </MSBuild>
    <Copy SourceFiles="@(KitTestAssembly)" DestinationFolder="$(OutDir)kits" SkipUnchangedFiles="true" />
  </Target>
