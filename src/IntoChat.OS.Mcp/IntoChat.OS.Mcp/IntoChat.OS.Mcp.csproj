<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>IntoChat.OS.Mcp</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../IntoChat.OS.Modules/IntoChat.OS/Identity/src/IntoChat.OS.Modules.Identity/IntoChat.OS.Modules.Identity.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Kernel/IntoChat.OS.Kernel.Composition/IntoChat.OS.Kernel.Composition.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Aspire/IntoChat.OS.Aspire.Client/IntoChat.OS.Aspire.Client.csproj" />
    <!-- Every module Contracts project, by convention: the host reads a neuron contract from its own loaded assemblies. -->
    <ProjectReference Include="../../IntoChat.OS.Modules/**/IntoChat.OS.Modules.*.Contracts.csproj" Exclude="../../IntoChat.OS.Modules/**/tests/**" />
    <PackageReference Include="IntoChat.OS.Modules.ClickHouse.Contracts" />
    <PackageReference Include="IntoChat.OS.Modules.Mcp.Contracts" />
    <PackageReference Include="IntoChat.OS.Modules.Microsoft.Azure.Contracts" />
    <PackageReference Include="IntoChat.OS.Modules.Microsoft.GitHub.Contracts" />
    <PackageReference Include="IntoChat.OS.Modules.Microsoft.Orleans.Contracts" />
    <PackageReference Include="IntoChat.OS.Modules.Microsoft.Playwright.Contracts" />
    <PackageReference Include="IntoChat.OS.Modules.Microsoft.Roslyn.Contracts" />
    <PackageReference Include="IntoChat.OS.Modules.Postgres.Contracts" />
    <PackageReference Include="IntoChat.OS.Modules.Salesforce.Contracts" />
    <PackageReference Include="IntoChat.OS.Modules.Tools.Contracts" />
    <!-- A module that hosts its own contracts (IntoChatOSContractsHost) has no Contracts project for the glob above: reference it itself. -->
    <PackageReference Include="IntoChat.OS.Modules.ArtCraft" />
    <PackageReference Include="IntoChat.OS.Modules.Google.Gmail" />
    <PackageReference Include="IntoChat.OS.Modules.Microsoft.Windows" />
    <PackageReference Include="IntoChat.OS.Modules.Time" />
    <!-- Tool sources are searched from here too: the registry is read through the cluster client. -->
    <PackageReference Include="IntoChat.OS.Modules.Tools" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Aspire.Azure.Storage.Blobs" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../../IntoChat.OS/Hosting/IntoChat.OS.Framework/IntoChat.OS.Framework.csproj" /></ItemGroup>
</Project>
