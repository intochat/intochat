<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>Sandbox host: one process holding each brain's session and its compiled behaviors.</Description>
    <RootNamespace>DigitalBrain.Modules.Microsoft.CSharp.Sandbox</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../../DigitalBrain.Aspire/DigitalBrain.ServiceDefaults/TelemetryExportBarrier.cs" Link="TelemetryExportBarrier.cs" />
    <!-- The protocol, the session connection and the client behaviors connect through; shared, never reloaded per behavior. -->
    <ProjectReference Include="../../../../DigitalBrain.Client/DigitalBrain.Client/DigitalBrain.Client.csproj" />
    <InternalsVisibleTo Include="DigitalBrain.Modules.Microsoft.CSharp.Tests" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
  </ItemGroup>
</Project>
