<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Supabase module contracts: read-only queries, schema reads and live query tables.</Description>
    <RootNamespace>DigitalBrain.Modules.Supabase.Contracts</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Neuron interfaces and signals use the DigitalBrain wire vocabulary; module runtime uses Framework. -->
    <ProjectReference Include="../../../DigitalBrain/DigitalBrain.csproj" />
  </ItemGroup>
  <ItemGroup><PackageReference Include="Microsoft.Orleans.Sdk" PrivateAssets="all" /></ItemGroup>
</Project>
