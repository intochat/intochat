<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>One proposed change to the brain's own source, running as a sibling cluster until promoted or discarded.</Description>
    <RootNamespace>DigitalBrain.Modules.Revisions.Contracts</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Neuron interfaces and signals use the DigitalBrain wire vocabulary; module runtime uses Framework. -->
    <ProjectReference Include="../../../../DigitalBrain/DigitalBrain.csproj" />
  </ItemGroup>
  <ItemGroup><PackageReference Include="Microsoft.Orleans.Sdk" PrivateAssets="all" /></ItemGroup>
</Project>