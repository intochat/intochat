{
  "appId": "photocraft",
  "scenario": "open",
  "side": null,
  "main": {
    "title": "PhotoCraft",
    "root": {
      "kind": "column",
      "children": [
        {
          "kind": "text",
          "value": "PhotoCraft tools connected (WASM Web UI) · Active: /work/portrait.png · /work/portrait.png -> /work/portrait.nobg.png",
          "tone": "muted",
          "tabular": true,
          "mono": false
        },
        {
          "kind": "row",
          "children": [
            {
              "kind": "button",
              "key": "preset-cutout",
              "label": "Remove Background",
              "emit": {
                "owner": "app.photocraft",
                "signal": "photocraft.remove-background",
                "args": {
                  "Document": "/work/portrait.png",
                  "Mode": "wasm-ui"
                }
              },
              "intent": null,
              "enabled": true,
              "tone": "accent",
              "style": "secondary",
              "icon": "wand-sparkles",
              "small": true
            },
            {
              "kind": "button",
              "key": "preset-warm",
              "label": "Warm Cinema",
              "emit": {
                "owner": "app.photocraft",
                "signal": "photocraft.apply-preset",
                "args": {
                  "Preset": "warm",
                  "Document": "/work/portrait.png",
                  "Mode": "wasm-ui"
                }
              },
              "intent": null,
              "enabled": true,
              "tone": "neutral",
              "style": "secondary",
              "small": true
            },
            {
              "kind": "button",
              "key": "preset-vivid",
              "label": "Vivid Pop",
              "emit": {
                "owner": "app.photocraft",
                "signal": "photocraft.apply-preset",
                "args": {
                  "Preset": "vivid",
                  "Document": "/work/portrait.png",
                  "Mode": "wasm-ui"
                }
              },
              "intent": null,
              "enabled": true,
              "tone": "neutral",
              "style": "secondary",
              "small": true
            },
            {
              "kind": "button",
              "key": "preset-mono",
              "label": "Monochrome",
              "emit": {
                "owner": "app.photocraft",
                "signal": "photocraft.apply-preset",
                "args": {
                  "Preset": "monochrome",
                  "Document": "/work/portrait.png",
                  "Mode": "wasm-ui"
                }
              },
              "intent": null,
              "enabled": true,
              "tone": "neutral",
              "style": "secondary",
              "small": true
            },
            {
              "kind": "button",
              "key": "preset-gradient",
              "label": "Gradient Canvas",
              "emit": {
                "owner": "app.photocraft",
                "signal": "photocraft.apply-preset",
                "args": {
                  "Preset": "gradient",
                  "Document": "/work/portrait.png",
                  "Mode": "wasm-ui"
                }
              },
              "intent": null,
              "enabled": true,
              "tone": "neutral",
              "style": "secondary",
              "small": true
            }
          ],
          "gap": 6,
          "padding": 0
        },
        {
          "kind": "row",
          "children": [
            {
              "kind": "button",
              "key": "toggle-layer-0",
              "label": "Hide: Subject Layer (100% · Normal)",
              "emit": {
                "owner": "app.photocraft",
                "signal": "photocraft.toggle-layer",
                "args": {
                  "LayerIndex": 0,
                  "LayerName": null
                }
              },
              "intent": null,
              "enabled": true,
              "tone": "neutral",
              "style": "secondary",
              "small": true
            },
            {
              "kind": "button",
              "key": "toggle-layer-1",
              "label": "Hide: Background Layer (Locked · 100%)",
              "emit": {
                "owner": "app.photocraft",
                "signal": "photocraft.toggle-layer",
                "args": {
                  "LayerIndex": 1,
                  "LayerName": null
                }
              },
              "intent": null,
              "enabled": true,
              "tone": "neutral",
              "style": "secondary",
              "small": true
            }
          ],
          "gap": 6,
          "padding": 0
        },
        {
          "kind": "text",
          "value": "Preview ready (PNG inline) · History: 0 step(s)",
          "tone": "muted",
          "tabular": true,
          "mono": false
        },
        {
          "kind": "webBrowser",
          "key": "photocraft-wasm",
          "url": "http://localhost:18082",
          "title": "PhotoCraft WASM Studio",
          "height": 0,
          "executionMode": "wasm-ui"
        }
      ],
      "gap": 6,
      "padding": 0
    }
  }
}
