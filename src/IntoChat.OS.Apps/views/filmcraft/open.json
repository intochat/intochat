{
  "appId": "filmcraft",
  "scenario": "open",
  "side": null,
  "main": {
    "title": "FilmCraft",
    "root": {
      "kind": "appShell",
      "key": "filmcraft-shell",
      "sidebar": null,
      "body": {
        "kind": "webBrowser",
        "key": "filmcraft-wasm",
        "url": "/artcraft/filmcraft/index.html",
        "title": "FilmCraft WASM Studio",
        "height": 920,
        "executionMode": "wasm-ui",
        "chrome": "frameless",
        "automationName": "FilmCraft WASM Studio"
      },
      "toolbar": {
        "kind": "row",
        "children": [
          {
            "kind": "tagPill",
            "label": "FilmCraft · WASM",
            "tone": "working",
            "icon": "loader-circle"
          },
          {
            "kind": "text",
            "value": "/work/launch-trailer.fcproj",
            "tone": "muted",
            "tabular": true,
            "mono": false
          },
          {
            "kind": "spacer",
            "size": 0
          },
          {
            "kind": "button",
            "key": "mode-mcp",
            "label": "MCP",
            "command": {
              "target": ".",
              "signal": "filmcraft.switch-mode",
              "args": {
                "mode": "mcp"
              }
            },
            "intent": null,
            "enabled": true,
            "tone": "neutral",
            "tooltip": null,
            "visible": true,
            "automationName": "mode-mcp",
            "style": "ghost",
            "small": true
          },
          {
            "kind": "button",
            "key": "mode-native-linux",
            "label": "CLI",
            "command": {
              "target": ".",
              "signal": "filmcraft.switch-mode",
              "args": {
                "mode": "native-linux"
              }
            },
            "intent": null,
            "enabled": true,
            "tone": "neutral",
            "tooltip": null,
            "visible": true,
            "automationName": "mode-native-linux",
            "style": "ghost",
            "small": true
          },
          {
            "kind": "button",
            "key": "mode-wasm-ui",
            "label": "WASM",
            "command": {
              "target": ".",
              "signal": "filmcraft.switch-mode",
              "args": {
                "mode": "wasm-ui"
              }
            },
            "intent": null,
            "enabled": true,
            "tone": "neutral",
            "tooltip": null,
            "visible": true,
            "automationName": "mode-wasm-ui",
            "style": "secondary",
            "small": true
          },
          {
            "kind": "button",
            "key": "razor-split",
            "label": "Razor Split",
            "command": {
              "target": ".",
              "signal": "filmcraft.run-command",
              "args": {
                "commandId": "timeline.razor",
                "sequence": "/work/launch-trailer.fcproj",
                "mode": "wasm-ui"
              }
            },
            "intent": null,
            "enabled": true,
            "tone": "neutral",
            "tooltip": null,
            "visible": true,
            "automationName": "razor-split",
            "style": "secondary",
            "icon": "scissors",
            "small": true
          },
          {
            "kind": "button",
            "key": "export-mp4",
            "label": "Export MP4",
            "command": {
              "target": ".",
              "signal": "filmcraft.export",
              "args": {
                "sequence": "/work/launch-trailer.fcproj",
                "mode": "wasm-ui"
              }
            },
            "intent": null,
            "enabled": true,
            "tone": "accent",
            "tooltip": null,
            "visible": true,
            "automationName": "export-mp4",
            "style": "primary",
            "icon": "film",
            "small": true
          }
        ],
        "gap": 4,
        "padding": 0
      },
      "inspector": null,
      "transition": "",
      "edgeToEdge": true,
      "automationName": "FilmCraft WASM Studio"
    }
  }
}
