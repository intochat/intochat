<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>First-party compiled shell apps for IntoChat OS.</Description>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IntoChat.OS.Apps.Tests.Unit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DigitalBrain.Capabilities.Storage" />
    
    <PackageReference Include="DigitalBrain.UI" />
    <PackageReference Include="DigitalBrain.Graph" />
    <ProjectReference Include="../IntoChat.OS.Modules/IntoChat.OS/Apps/Contracts/IntoChat.OS.Modules.Apps.Contracts/IntoChat.OS.Modules.Apps.Contracts.csproj" />
    <ProjectReference Include="../IntoChat.OS.Modules/IntoChat.OS/Apps/src/IntoChat.OS.Modules.Apps/IntoChat.OS.Modules.Apps.csproj" />
    <ProjectReference Include="../IntoChat.OS.Modules/IntoChat.OS/Flame/Contracts/IntoChat.OS.Modules.Flame.Contracts/IntoChat.OS.Modules.Flame.Contracts.csproj" />
    <ProjectReference Include="../IntoChat.OS.Modules/AI/Contracts/IntoChat.OS.Modules.AI.Contracts/IntoChat.OS.Modules.AI.Contracts.csproj" />
    <ProjectReference Include="../IntoChat.OS.Modules/ArtCraft/ArtCraft/src/IntoChat.OS.Modules.ArtCraft/IntoChat.OS.Modules.ArtCraft.csproj" />
    <ProjectReference Include="../IntoChat.OS.Modules/LocalDisk/src/IntoChat.OS.Modules.LocalDisk/IntoChat.OS.Modules.LocalDisk.csproj" />
    <ProjectReference Include="../IntoChat.OS.Modules/ModelContextProtocol/Mcp/Contracts/IntoChat.OS.Modules.Mcp.Contracts/IntoChat.OS.Modules.Mcp.Contracts.csproj" />
    <ProjectReference Include="../IntoChat.OS.Modules/Microsoft/Aspire/Contracts/IntoChat.OS.Modules.Microsoft.Aspire.Contracts/IntoChat.OS.Modules.Microsoft.Aspire.Contracts.csproj" />
    <ProjectReference Include="../IntoChat.OS.Modules/IntoChat.OS/Tools/Contracts/IntoChat.OS.Modules.Tools.Contracts/IntoChat.OS.Modules.Tools.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Ino/ino-instructions.md" LogicalName="IntoChat.OS.Apps.Ino.ino-instructions.md" />
    <EmbeddedResource Include="Creator/ui-expert-instructions.md" LogicalName="IntoChat.OS.Apps.Creator.ui-expert-instructions.md" />
  </ItemGroup>
  <!-- Shipped unit sources: synapse units the OS deploys through the synapse studio, never compiled into this assembly. -->
  <ItemGroup>
    <Compile Remove="Units/**/*.cs" />
    <None Remove="Units/**" />
    <EmbeddedResource Include="Units/CircleRoom/CircleRoom.cs" LogicalName="IntoChat.OS.Apps.Units.circleroom/CircleRoom.cs" />
    <EmbeddedResource Include="Units/CircleRoom/spec.md" LogicalName="IntoChat.OS.Apps.Units.circleroom/spec.md" />
    <EmbeddedResource Include="Units/CircleRoom/scenarios.json" LogicalName="IntoChat.OS.Apps.Units.circleroom/scenarios.json" />
  </ItemGroup>
</Project>
