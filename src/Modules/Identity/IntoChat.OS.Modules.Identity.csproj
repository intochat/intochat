<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The identity module: accounts, brains, grants, sessions, the vault, connections and integrations (identity@1 and secrets@1).</Description>
    <NoWarn>$(NoWarn);CA1812</NoWarn>
    <!-- Compile-time minimal-API binding: removes the RequestDelegateFactory IL2026/IL3050 per route. -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Contracts/**" />
    <EmbeddedResource Remove="Contracts/**" />
    <None Remove="Contracts/**" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <ProjectReference Include="../../../framework/src/DigitalBrain/DigitalBrain.csproj" />
    <ProjectReference Include="../../../framework/src/DigitalBrain.Identity.Local/DigitalBrain.Identity.Local.csproj" />
    <ProjectReference Include="../../../framework/src/DigitalBrain.Runtime.Http/DigitalBrain.Runtime.Http.csproj" />
    <ProjectReference Include="../../../framework/src/DigitalBrain.Runtime.Orleans/DigitalBrain.Runtime.Orleans.csproj" />
    <PackageReference Include="Microsoft.Orleans.Reminders" />
    <PackageReference Include="Microsoft.Orleans.Sdk" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Orleans.Server" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../IntoChat.OS/IntoChat.OS.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Host/IntoChat.OS.Host.csproj" />
    <ProjectReference Include="Contracts/IntoChat.OS.Modules.Identity.Contracts.csproj" />
  </ItemGroup>
</Project>
