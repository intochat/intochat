<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>IntoChat.OS.Modules.Microsoft.Roslyn</RootNamespace>
    <Description>Roslyn workspace loading, diagnostics, and C# code edits.</Description>
    <NoWarn>$(NoWarn);CA1812</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DigitalBrain" />
    <PackageReference Include="DigitalBrain.Capabilities.Connections" />
    <PackageReference Include="DigitalBrain.Runtime.Orleans" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../IntoChat.OS/IntoChat.OS.csproj" />
  </ItemGroup>
</Project>
