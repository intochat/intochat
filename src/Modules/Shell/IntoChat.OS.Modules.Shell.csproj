<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>IntoChat.OS.Modules.Flutter</RootNamespace>
    <Description>Shell workspace, screen gateway, view nodes, chat, and UI endpoints.</Description>
    <!-- Compile-time minimal-API binding: removes the RequestDelegateFactory IL2026/IL3050 per route. -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../framework/src/DigitalBrain.UI/DigitalBrain.UI.csproj" />
    <ProjectReference Include="../../../framework/src/DigitalBrain.Capabilities.Compute/DigitalBrain.Capabilities.Compute.csproj" />
    <ProjectReference Include="../../../framework/src/DigitalBrain.Capabilities.Connections/DigitalBrain.Capabilities.Connections.csproj" />
    <ProjectReference Include="../../../framework/src/DigitalBrain.Runtime.Http/DigitalBrain.Runtime.Http.csproj" />
    <PackageReference Include="Microsoft.Orleans.Serialization.SystemTextJson" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Contracts/**" />
    <EmbeddedResource Remove="Contracts/**" />
    <None Remove="Contracts/**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Contracts/IntoChat.OS.Modules.Shell.Contracts.csproj" />
    <ProjectReference Include="../../IntoChat.OS/IntoChat.OS.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Host/IntoChat.OS.Host.csproj" />
    <ProjectReference Include="../Catalog/Contracts/IntoChat.OS.Modules.Catalog.Contracts.csproj" />
    <ProjectReference Include="../Identity/Contracts/IntoChat.OS.Modules.Identity.Contracts.csproj" />
    <ProjectReference Include="../Playwright/IntoChat.OS.Modules.Playwright.csproj" />
    <ProjectReference Include="../../Components/Aspire/Contracts/IntoChat.Aspire.Contracts.csproj" />
  </ItemGroup>
</Project>
