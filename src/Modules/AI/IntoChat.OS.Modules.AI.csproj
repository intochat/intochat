<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>IntoChat.OS.Modules.AI</RootNamespace>
    <Description>AI module: multi-provider LLM and embedding clients, agents, and voice transcription.</Description>
    <NoWarn>$(NoWarn);CA1812</NoWarn>
    <RuntimeIdentifiers Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Contracts/**" />
    <EmbeddedResource Remove="Contracts/**" />
    <None Remove="Contracts/**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Contracts/IntoChat.OS.Modules.AI.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Microsoft.Orleans.Sdk" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Orleans.Serialization.SystemTextJson" />
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="Microsoft.AI.Foundry.Local" PrivateAssets="contentfiles;analyzers;build;buildTransitive" />
    <PackageReference Include="Concentus" />
    <PackageReference Include="Concentus.Oggfile" />
    <PackageReference Include="NAudio" />
    <ProjectReference Include="../../../framework/src/DigitalBrain.Graph/DigitalBrain.Graph.csproj" />
    <ProjectReference Include="../../../framework/src/DigitalBrain.Capabilities.Compute/DigitalBrain.Capabilities.Compute.csproj" />
    <ProjectReference Include="../../../framework/src/DigitalBrain.Capabilities.Connections/DigitalBrain.Capabilities.Connections.csproj" />
    <ProjectReference Include="../../../framework/src/DigitalBrain.Runtime.Http/DigitalBrain.Runtime.Http.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../IntoChat.OS/IntoChat.OS.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Framework/IntoChat.OS.Framework.csproj" />
    <ProjectReference Include="../GitHub/IntoChat.OS.Modules.GitHub.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Pricing/models.prices.json" LogicalName="IntoChat.OS.Modules.AI.Pricing.models.prices.json" />
  </ItemGroup>
</Project>
