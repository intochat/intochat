<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Brain workspace bounded context: workspace shell, screens, views, app catalog, runtime authoring, runs, diagnostics, files, social, flows, and Ino tools.</Description>
    <!-- Compile-time minimal-API binding: removes the RequestDelegateFactory IL2026/IL3050 per route. -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="DigitalBrain.ReplacesAssembly" Value="IntoChat.OS.Modules.Catalog" />
    <AssemblyMetadata Include="DigitalBrain.ReplacesAssembly" Value="IntoChat.OS.Modules.Shell" />
    <AssemblyMetadata Include="DigitalBrain.ReplacesAssembly" Value="IntoChat.OS.Modules.Authoring" />
    <AssemblyMetadata Include="DigitalBrain.ReplacesAssembly" Value="IntoChat.OS.Modules.Runs" />
    <AssemblyMetadata Include="DigitalBrain.ReplacesAssembly" Value="IntoChat.OS.Modules.Diagnostics" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../IntoChat.OS.Contracts/IntoChat.OS.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../framework/src/DigitalBrain/DigitalBrain.csproj" />
    <ProjectReference Include="../../../framework/src/DigitalBrain.Runtime.Http/DigitalBrain.Runtime.Http.csproj" />
    <ProjectReference Include="../../../framework/src/DigitalBrain.Simulation/DigitalBrain.Simulation.csproj" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Orleans.Sdk" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Orleans.Serialization.SystemTextJson" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../IntoChat.OS/IntoChat.OS.csproj" />
    <ProjectReference Include="../../IntoChat.OS.UI/IntoChat.OS.UI.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Host/IntoChat.OS.Host.csproj" />
    <ProjectReference Include="../Identity/Contracts/IntoChat.OS.Modules.Identity.Contracts.csproj" />
    <ProjectReference Include="../Infrastructure/IntoChat.OS.Modules.Infrastructure.csproj" />
    <ProjectReference Include="../Plugins/IntoChat.OS.Modules.Plugins.csproj" />
    <ProjectReference Include="../AI/IntoChat.OS.Modules.AI.csproj" />
    <ProjectReference Include="../UI/IntoChat.OS.Modules.UI.csproj" />
  </ItemGroup>
</Project>
