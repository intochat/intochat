<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Mail module: Azure Communication Services email behind IMailSender, a log sender for tests and development, and a per-recipient rate neuron. Loaded only when Topology=cloud.</Description>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="DigitalBrain" />
    <PackageReference Include="DigitalBrain.Capabilities.Secrets" />
    <ProjectReference Include="../../Contracts/IntoChat.Cloud.Mail.Contracts/IntoChat.Cloud.Mail.Contracts.csproj" />
    <PackageReference Include="Azure.Communication.Email" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IntoChat.Cloud.Mail.Tests.Unit" />
  </ItemGroup>
</Project>
