<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Hosting module: hosted-allocation options and the grain-state migration guard. Loaded only when Topology=cloud. Per-allocation Orleans grain storage is not in this module.</Description>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="DigitalBrain" />
  </ItemGroup>
</Project>
