<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Lobby module: one cloud lobby brain, visitor token, handoff into a member session, and value-tree sign-in screens. Loaded only when Topology=cloud.</Description>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="DigitalBrain" />
    <PackageReference Include="DigitalBrain.UI" />
    <PackageReference Include="DigitalBrain.Capabilities.Identity" />
    <PackageReference Include="DigitalBrain.Runtime.Http" />
    <ProjectReference Include="../../../Localization/src/IntoChat.Cloud.Localization/IntoChat.Cloud.Localization.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IntoChat.Cloud.Lobby.Tests.Unit" />
  </ItemGroup>
</Project>
