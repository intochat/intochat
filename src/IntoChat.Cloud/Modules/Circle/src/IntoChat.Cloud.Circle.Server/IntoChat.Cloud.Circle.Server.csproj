    <ProjectReference Include="../../../../../IntoChat.OS.Modules/IntoChat.OS/Circles/IntoChat.OS.Modules.Circles.Contracts/IntoChat.OS.Modules.Circles.Contracts.csproj" />
    <ProjectReference Include="../../Contracts/IntoChat.Cloud.Circle.Contracts/IntoChat.Cloud.Circle.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IntoChat.Cloud.Circle.Server.Tests.Unit" />
