<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <RootNamespace>IntoChat.OS.Aspire.Hosting</RootNamespace>
    <Description>Core IntoChat.OS AppHost composition: Orleans, stores, module selection, and silo/client projection.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" />
    <PackageReference Include="Aspire.Hosting.ClickHouse" />
    <PackageReference Include="Aspire.Hosting.Orleans" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Qdrant" />
    <PackageReference Include="Aspire.Hosting.Yarp" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Ollama" />
    <PackageReference Include="Microsoft.AI.Foundry.Local" ExcludeAssets="build;buildTransitive;contentfiles" PrivateAssets="contentfiles;analyzers;build;buildTransitive" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../IntoChat.OS/Hosting/IntoChat.OS.Framework/IntoChat.OS.Framework.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Modules/AI/src/IntoChat.OS.Modules.AI/IntoChat.OS.Modules.AI.csproj" />
    <PackageReference Include="IntoChat.OS.Modules.ArtCraft" />
    <PackageReference Include="IntoChat.OS.Modules.ClickHouse" />
    <ProjectReference Include="../../IntoChat.OS.Modules/Google/Flutter/src/IntoChat.OS.Modules.Flutter/IntoChat.OS.Modules.Flutter.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Modules/IntoChat.OS/Identity/src/IntoChat.OS.Modules.Identity/IntoChat.OS.Modules.Identity.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Modules/Microsoft/Aspire/src/IntoChat.OS.Modules.Microsoft.Aspire/IntoChat.OS.Modules.Microsoft.Aspire.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Modules/Microsoft/CSharp/src/IntoChat.OS.Modules.Microsoft.CSharp/IntoChat.OS.Modules.Microsoft.CSharp.csproj" />
    <PackageReference Include="IntoChat.OS.Modules.Microsoft.GitHub" />
    <ProjectReference Include="../../IntoChat.OS.Kernel/IntoChat.OS.Kernel.Composition/IntoChat.OS.Kernel.Composition.csproj" />
    <PackageReference Include="IntoChat.OS.Modules.Postgres" />
    <PackageReference Include="IntoChat.OS.Modules.Qdrant" />
    <PackageReference Include="IntoChat.OS.Modules.Supabase" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Seeds/*.sql" LogicalName="Seeds/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="IntoChat.OS.Aspire.Hosting.Tests.Unit" /></ItemGroup>
</Project>
