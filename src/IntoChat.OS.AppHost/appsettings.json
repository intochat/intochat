{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "IntoChatOS": {
    "Identity": {
      "CookieName": "intochat.session",
      "ProtectionApplicationName": "IntoChat.v1",
      "ProtectionContainerName": "intochat-protection-v1"
    },
    "Modules": {
      "ai": {
        "Options": {
          "Telemetry": {
            "EnableSensitiveData": "true"
          }
        }
      }
    },
    "Platform": {
      "Storage": {
        "WriteFormat": "Framed"
      }
    }
  }
}
