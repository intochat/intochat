{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "IntoChatOS": {
    "Modules": {
      "ai": {
        "Options": {
          "Telemetry": {
            "EnableSensitiveData": "true"
          }
        }
      },
      "flutter": {
        "Options": {
          "Hosting": {
            "AndroidTransport": "Auto",
            "IosTransport": "Auto"
          }
        }
      }
    }
  }
}
