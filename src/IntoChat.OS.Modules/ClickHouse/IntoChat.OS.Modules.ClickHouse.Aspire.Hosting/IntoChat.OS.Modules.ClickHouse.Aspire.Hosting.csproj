<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Aspire AppHost integration for the IntoChat.OS ClickHouse module.</Description>
    <RootNamespace>IntoChat.OS.Modules.ClickHouse.Aspire.Hosting</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.ClickHouse" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Seeds/*.sql" LogicalName="Seeds/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../IntoChat.OS.Modules.ClickHouse.Contracts/IntoChat.OS.Modules.ClickHouse.Contracts.csproj" />
    <ProjectReference Include="../IntoChat.OS.Modules.ClickHouse/IntoChat.OS.Modules.ClickHouse.csproj" />
    <ProjectReference Include="../../../IntoChat.OS.Aspire/IntoChat.OS.Aspire.Hosting/IntoChat.OS.Aspire.Hosting.csproj" />
  </ItemGroup>
</Project>
