<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Orleans as a module: the cluster neuron and membership feed, and the cloud topology (DigitalBrain.Runtime.Orleans.Azure) for Topology=cloud.</Description>
    <RootNamespace>IntoChat.OS.Modules.Microsoft.Orleans</RootNamespace>
    <NoWarn>$(NoWarn);ORLEANSEXP005</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IntoChat.OS.Modules.Microsoft.Orleans.Tests.Unit" />
    <InternalsVisibleTo Include="IntoChat.OS.Modules.Microsoft.Orleans.Tests.Integration" />
    <!-- The cloud topology (Topology=cloud): only this module references the Azure runtime package (03-12). -->
    <PackageReference Include="DigitalBrain.Runtime.Orleans.Azure" />
    <ProjectReference Include="../IntoChat.OS.Modules.Microsoft.Orleans.Contracts/IntoChat.OS.Modules.Microsoft.Orleans.Contracts.csproj" />
    <ProjectReference Include="../../../../IntoChat.OS.Framework/IntoChat.OS.Framework/IntoChat.OS.Framework.csproj" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../../../../IntoChat.OS.Connections/IntoChat.OS.Connections/IntoChat.OS.Connections.csproj" /></ItemGroup>
</Project>
