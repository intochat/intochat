<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Orleans as a module: clustering, grain state and reminders as one integration; memory when it is absent.</Description>
    <RootNamespace>IntoChat.OS.Modules.Microsoft.Orleans</RootNamespace>
    <NoWarn>$(NoWarn);ORLEANSEXP005</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IntoChat.OS.Modules.Microsoft.Orleans.Tests.Unit" />
    <InternalsVisibleTo Include="IntoChat.OS.Modules.Microsoft.Orleans.Tests.Integration" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Orleans.Clustering.AzureStorage" />
    <PackageReference Include="Microsoft.Orleans.Persistence.AzureStorage" />
    <PackageReference Include="Microsoft.Orleans.Reminders.AzureStorage" />
    <PackageReference Include="Microsoft.Orleans.Reminders" />
    <ProjectReference Include="../IntoChat.OS.Modules.Microsoft.Orleans.Contracts/IntoChat.OS.Modules.Microsoft.Orleans.Contracts.csproj" />
    <ProjectReference Include="../../../../IntoChat.OS.Framework/IntoChat.OS.Framework/IntoChat.OS.Framework.csproj" />
  </ItemGroup>
</Project>
