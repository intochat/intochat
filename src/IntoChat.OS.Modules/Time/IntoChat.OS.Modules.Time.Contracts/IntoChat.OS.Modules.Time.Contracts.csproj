<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Typed timer operations, snapshots and live elapsed facts.</Description>
    <RootNamespace>IntoChat.OS.Modules.Time.Contracts</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Neuron interfaces and signals use the IntoChat.OS wire vocabulary; module runtime uses Framework. -->
    <ProjectReference Include="../../../IntoChat.OS/IntoChat.OS.csproj" />
  </ItemGroup>
  <ItemGroup><PackageReference Include="Microsoft.Orleans.Sdk" PrivateAssets="all" /></ItemGroup>
</Project>
