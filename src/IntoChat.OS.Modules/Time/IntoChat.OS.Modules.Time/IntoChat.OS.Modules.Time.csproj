    <Description>Activation-local timers and persistent periodic reminders with live typed ticks.</Description>
    <RootNamespace>IntoChat.OS.Modules.Time</RootNamespace>
    <IntoChatOSContractsHost>true</IntoChatOSContractsHost>
    <NoWarn>$(NoWarn);ORLEANSEXP005</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Reminders" />
    <InternalsVisibleTo Include="IntoChat.OS.Modules.Time.Tests.Integration" />
    <InternalsVisibleTo Include="IntoChat.OS.Modules.Time.Tests.Unit" />
    <ProjectReference Include="../../../IntoChat.OS.Framework/IntoChat.OS.Framework/IntoChat.OS.Framework.csproj" />
  </ItemGroup>
</Project>
