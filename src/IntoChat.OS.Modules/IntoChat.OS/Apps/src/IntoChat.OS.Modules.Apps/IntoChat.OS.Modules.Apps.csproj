<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>App manifests, install, versions and Save as app.</Description>
    <RootNamespace>IntoChat.OS.Modules.Apps</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DigitalBrain.Capabilities.Storage" />
    <PackageReference Include="DigitalBrain.UI" />
    <PackageReference Include="DigitalBrain.Graph" />
    <PackageReference Include="DigitalBrain.Apps.Packaging" />
    <InternalsVisibleTo Include="IntoChat.OS.Modules.Apps.Tests.Unit" />
    <InternalsVisibleTo Include="IntoChat.OS.Modules.Apps.Tests.Integration" />
    <ProjectReference Include="../../../Flame/Contracts/IntoChat.OS.Modules.Flame.Contracts/IntoChat.OS.Modules.Flame.Contracts.csproj" />
    <ProjectReference Include="../../Contracts/IntoChat.OS.Modules.Apps.Contracts/IntoChat.OS.Modules.Apps.Contracts.csproj" />
    <PackageReference Include="IntoChat.OS.Modules.LocalDisk" />
    <PackageReference Include="IntoChat.OS.Modules.ArtCraft" />
    <PackageReference Include="IntoChat.OS.Modules.Mcp.Contracts" />
    <PackageReference Include="IntoChat.OS.Modules.Tools.Contracts" />
    <PackageReference Include="IntoChat.OS.Modules.Microsoft.CSharp.Contracts" />
    <PackageReference Include="IntoChat.OS.Modules.Microsoft.Aspire.Contracts" />
    <PackageReference Include="IntoChat.OS.Modules.AI.Contracts" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../../../../../IntoChat.OS/Hosting/IntoChat.OS.Framework/IntoChat.OS.Framework.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../../../Identity/src/IntoChat.OS.Modules.Identity/IntoChat.OS.Modules.Identity.csproj" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>
  <ItemGroup>
    <!-- Script sources of the compiled shell apps. They stay programs the sandbox runs; they are not module C#. -->
    <Compile Remove="Shell\**\*.cs" />
    <None Remove="Shell\**\*" />
    <EmbeddedResource Include="Shell\**\*" LogicalName="shell/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
