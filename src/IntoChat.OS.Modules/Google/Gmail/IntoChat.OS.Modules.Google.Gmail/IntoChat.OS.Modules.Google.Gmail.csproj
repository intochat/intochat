<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IntoChatOSModule>true</IntoChatOSModule>
    <IntoChatOSContractsHost>true</IntoChatOSContractsHost>
    <Description>Google module: hosted Gmail MCP tools, browser sign-in, draft previews and Google Drive as read-only storage.</Description>
    <RootNamespace>IntoChat.OS.Modules.Google.Gmail</RootNamespace>
    <NoWarn>$(NoWarn);ORLEANSEXP005</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IntoChat.OS.Modules.Google.Gmail.Tests.Unit" />
    <InternalsVisibleTo Include="IntoChat.OS.Modules.Google.Gmail.Tests.Integration" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../IntoChat.OS.Framework/IntoChat.OS.Framework/IntoChat.OS.Framework.csproj" />
  </ItemGroup>
</Project>
