<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- CI discovers E2E suites by csproj; this flag tells the leg to install the Playwright browser and warm the shell image. -->
    <E2EBrowser>true</E2EBrowser>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Playwright" />
    <ProjectReference Include="../../Testing/DigitalBrain.Testing.E2E/DigitalBrain.Testing.E2E.csproj" />
    <ProjectReference Include="../../Testing/DigitalBrain.Testing.Reference/DigitalBrain.Testing.Reference.csproj" />
    <ProjectReference Include="../DigitalBrain.OS/DigitalBrain.OS.csproj" />
    <ProjectReference Include="../../DigitalBrain.AppHost/DigitalBrain.AppHost.csproj" IsAspireProjectResource="false" />
    <None Update="testconfig.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
