<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Local runs write grain state under this folder. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);.digitalbrain/**</DefaultItemExcludes>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>DigitalBrain.OS</PackageId>
    <Description>The operating system: the named module composition, the OS apps, and the host that runs them.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- The repository's features folder rides in the published image at {publish}/features, where
         Properties/PublishProfiles/Container.pubxml points AppsOptions.Features. Never compiled here. -->
    <None Include="../../../features/**/*" LinkBase="features" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DigitalBrain.OS.Tests.E2E" />
    <InternalsVisibleTo Include="DigitalBrain.OS.Tests.Unit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../DigitalBrain.Aspire/DigitalBrain.Aspire.Server/DigitalBrain.Aspire.Server.csproj" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <ProjectReference Include="../../DigitalBrain.Platform/DigitalBrain.Platform/DigitalBrain.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The OS is the composition of every module in the repo; OsCatalog names them in code
         and the compiler checks the two agree. Hosting, deployment, contracts, testing and
         sandbox projects ride along with their module or belong to other rings. -->
    <ProjectReference Include="../../DigitalBrain.Modules/**/DigitalBrain.Modules.*.csproj"
                      Exclude="../../DigitalBrain.Modules/**/tests/**;
                               ../../DigitalBrain.Modules/**/DigitalBrain.Modules.*.Aspire.Hosting.csproj;
                               ../../DigitalBrain.Modules/**/DigitalBrain.Modules.*.Deployment.csproj;
                               ../../DigitalBrain.Modules/**/DigitalBrain.Modules.*.Testing.csproj;
                               ../../DigitalBrain.Modules/**/DigitalBrain.Modules.*.Contracts.csproj;
                               ../../DigitalBrain.Modules/**/DigitalBrain.Modules.*.Sandbox.csproj" />
  </ItemGroup>
</Project>
