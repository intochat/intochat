<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Module SDK: attributes, module base and build-time generator.</Description>
    <RootNamespace>IntoChat.OS.Sdk</RootNamespace>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IntoChatOSPackGenerator</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Module.Configure(ISiloBuilder) moves here in 09-07 until W1 IRuntimeBuilder. -->
    <PackageReference Include="Microsoft.Orleans.Server" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../IntoChat.OS/IntoChat.OS.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Framework/IntoChat.OS.Contracts.Configuration/IntoChat.OS.Contracts.Configuration.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Framework/IntoChat.OS.Contracts.Compute/IntoChat.OS.Contracts.Compute.csproj" />
    <ProjectReference Include="../IntoChat.OS.Sdk.Generators/IntoChat.OS.Sdk.Generators.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- The generator ships under analyzers/dotnet/cs, never lib/. -->
  <Target Name="IntoChatOSPackGenerator">
    <MSBuild Projects="../IntoChat.OS.Sdk.Generators/IntoChat.OS.Sdk.Generators.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_IntoChatOSGeneratorDll" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_IntoChatOSGeneratorDll)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
</Project>
