<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- Same version Orleans pulls transitively; VersionOverride avoids a central entry (which would downgrade the Roslyn module). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.0.0" />
    <ProjectReference Include="../IntoChat.OS.Sdk.Generators/IntoChat.OS.Sdk.Generators.csproj" ReferenceOutputAssembly="true" />
    <ProjectReference Include="../IntoChat.OS.Sdk/IntoChat.OS.Sdk.csproj" />
    <ProjectReference Include="../IntoChat.OS.Sdk.Http/IntoChat.OS.Sdk.Http.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Framework/IntoChat.OS.Framework/IntoChat.OS.Framework.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Aspire/IntoChat.OS.Aspire.Hosting/IntoChat.OS.Aspire.Hosting.csproj" />
  </ItemGroup>
  <ItemGroup><Using Remove="IntoChat.OS.Testing" /></ItemGroup>
  <!-- Goldens are data compared as text, never compiled into the test assembly. -->
  <ItemGroup><Compile Remove="Goldens/**" /><None Include="Goldens/**" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><None Include="../IntoChat.OS.Sdk.SampleModule/*.cs" Link="SampleSources/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
