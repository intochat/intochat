<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Deploys the DigitalBrain OS silo into a foundation another program owns (environment, identity, vault, registry, storage), with Pulumi and no foundation of its own.</Description>
    <RootNamespace>DigitalBrain.Deployment.Runtime</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Pulumi" />
    <PackageReference Include="Pulumi.AzureNative" />
    <ProjectReference Include="../../DigitalBrain.Framework/DigitalBrain.Contracts.Configuration/DigitalBrain.Contracts.Configuration.csproj" />
  </ItemGroup>
</Project>
