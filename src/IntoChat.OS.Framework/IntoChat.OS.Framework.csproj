<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IntoChatOSContractsHost>true</IntoChatOSContractsHost>
    <RootNamespace>IntoChat.OS.Framework</RootNamespace>
    <Description>OS runtime hosting, authority, identity, secrets, connections, service defaults, and Orleans client helpers.</Description>
    <NoWarn>$(NoWarn);CS1591;ORLEANSEXP005;CA1812</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="DigitalBrain.Capabilities.Compute" />
    <PackageReference Include="DigitalBrain.Capabilities.Connections" />
    <PackageReference Include="DigitalBrain.Identity.Local" />
    <PackageReference Include="DigitalBrain.Runtime.Http" />
    <PackageReference Include="DigitalBrain.Runtime.Orleans" />
    <PackageReference Include="DigitalBrain.UI" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.Web" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
    <PackageReference Include="Microsoft.Orleans.Client" />
    <PackageReference Include="Microsoft.Orleans.Reminders" />
    <PackageReference Include="Microsoft.Orleans.Sdk" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Orleans.Server" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../IntoChat.OS/IntoChat.OS.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Authority/Neurons/neurons.proto" GrpcServices="Both" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IntoChat.OS.Kernel" />
    <InternalsVisibleTo Include="IntoChat.OS.AppHost" />
    <InternalsVisibleTo Include="IntoChat.OS.Tests.Unit" />
    <InternalsVisibleTo Include="IntoChat.OS.Tests.Integration" />
    <InternalsVisibleTo Include="IntoChat.OS.Tests.E2E" />
    <InternalsVisibleTo Include="IntoChat.OS.Architecture.Tests.Unit" />
    <InternalsVisibleTo Include="IntoChat.OS.Modules.Shell" />
    <InternalsVisibleTo Include="IntoChat.OS.Modules.Catalog" />
    <InternalsVisibleTo Include="IntoChat.OS.Modules.AI" />
  </ItemGroup>
</Project>
