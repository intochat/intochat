<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- Same version Orleans pulls transitively; VersionOverride avoids a central entry (which would downgrade the Roslyn module). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.0.0" />
    <ProjectReference Include="../IntoChat.OS.Framework.Generators/IntoChat.OS.Framework.Generators.csproj" ReferenceOutputAssembly="true" />
    <ProjectReference Include="../IntoChat.OS.Framework/IntoChat.OS.Framework.csproj" />
    <ProjectReference Include="../../IntoChat.OS.Aspire/IntoChat.OS.Aspire.Hosting/IntoChat.OS.Aspire.Hosting.csproj" />
  </ItemGroup>
  <ItemGroup><Using Remove="IntoChat.OS.Testing" /></ItemGroup>
  <!-- Goldens and the test-local sample module are data compared or compiled in memory, never compiled into the test assembly. -->
  <ItemGroup><Compile Remove="Goldens/**;SampleSources/**" /><None Include="Goldens/**" CopyToOutputDirectory="PreserveNewest" /><None Include="SampleSources/*.cs" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
