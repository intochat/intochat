<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>preview-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <!-- NU5104: .NET 11 is still RC, so stable DigitalBrain packages depend on prerelease Microsoft packages; remove at .NET 11 GA -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
    <!-- Web SDK defaults this true; on Linux that forces RID=linux-x64 for every project.
         Container publishes opt back in via PublishProfiles/Container.pubxml + deploy.yml. -->
    <EnableSdkContainerSupport>false</EnableSdkContainerSupport>
    <!-- Every project builds into artifacts/bin/<project>/<config>, so CI uploads one tree and
         runs prebuilt test modules from that tree. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
  </PropertyGroup>
  <!-- GitHub Actions sets CI=true. Keep solution builds portable (no -r on .slnx). -->
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <RuntimeIdentifier></RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup>
    <DigitalBrainVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</DigitalBrainVersion>
    <VersionPrefix>$(DigitalBrainVersion)</VersionPrefix>
    <Authors>Digital Brain Tech</Authors>
    <!-- MIT covers the SDK tier only: the vocabulary, contracts, client and testing packages. Runtime packages
         carry no licence expression until the runtime licence is decided (handbook vision/commercial.md). -->
    <DigitalBrainSdkPackage Condition="'$(MSBuildProjectName)' == 'DigitalBrain' Or '$(MSBuildProjectName)' == 'DigitalBrain.Client'
        Or '$(MSBuildProjectName)' == 'DigitalBrain.Client.Orleans' Or '$(MSBuildProjectName)' == 'DigitalBrain.Aspire.Client'
        Or '$(MSBuildProjectName)' == 'DigitalBrain.Testing' Or '$(MSBuildProjectName)' == 'DigitalBrain.Testing.Aspire'
        Or '$(MSBuildProjectName)' == 'DigitalBrain.Aspire.Testing' Or '$(MSBuildProjectName)' == 'DigitalBrain.Testing.Playwright'
        Or $(MSBuildProjectName.EndsWith('.Contracts'))">true</DigitalBrainSdkPackage>
    <PackageLicenseExpression Condition="'$(DigitalBrainSdkPackage)' == 'true'">MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/intochat/os</PackageProjectUrl>
    <RepositoryUrl>https://github.com/intochat/os</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>agents;orleans;aspire;durable;actors</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Every test project in the repo, replacing the boilerplate that used to be copied into each
       .csproj. This is repository convention only: package consumers choose their own test runner
       and project shape, and get just the Aspire target from DigitalBrain.Testing.Aspire. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) Or $(MSBuildProjectName.Contains('.Tests.'))">
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <!-- The tier comes from the suffix; CI shards on `dotnet msbuild -getProperty:DigitalBrainTestTier`. -->
    <DigitalBrainTestTier>Legacy</DigitalBrainTestTier>
    <DigitalBrainTestTier Condition="$(MSBuildProjectName.EndsWith('.Tests.Unit'))">Unit</DigitalBrainTestTier>
    <DigitalBrainTestTier Condition="$(MSBuildProjectName.EndsWith('.Tests.Integration'))">Integration</DigitalBrainTestTier>
    <DigitalBrainTestTier Condition="$(MSBuildProjectName.EndsWith('.Tests.E2E'))">E2E</DigitalBrainTestTier>
    <DigitalBrainTestTier Condition="$(MSBuildProjectName.EndsWith('.Tests.Browser'))">Browser</DigitalBrainTestTier>
    <DigitalBrainTestTier Condition="$(MSBuildProjectName.EndsWith('.Tests.Hosting'))">Hosting</DigitalBrainTestTier>
    <!-- DigitalBrainNightly=false drops the nightly tiers (E2E, Browser) from `dotnet test`.
         DigitalBrainE2E=false is the previous name, kept for one release. -->
    <DigitalBrainNightly Condition="'$(DigitalBrainNightly)' == '' And '$(DigitalBrainE2E)' == 'false'">false</DigitalBrainNightly>
    <DigitalBrainNightly Condition="'$(DigitalBrainNightly)' == ''">true</DigitalBrainNightly>
    <IsTestProject Condition="'$(DigitalBrainNightly)' == 'false' And ('$(DigitalBrainTestTier)' == 'E2E' Or '$(DigitalBrainTestTier)' == 'Browser')">false</IsTestProject>
    <IsTestingPlatformApplication Condition="'$(DigitalBrainNightly)' == 'false' And ('$(DigitalBrainTestTier)' == 'E2E' Or '$(DigitalBrainTestTier)' == 'Browser')">false</IsTestingPlatformApplication>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
    <NoWarn>$(NoWarn);ORLEANSEXP005;CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) Or $(MSBuildProjectName.Contains('.Tests.'))">
    <PackageReference Include="xunit.v3.mtp-v2" />
    <Using Include="Xunit" />
    <Using Include="DigitalBrain.Testing" />
  </ItemGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests.E2E'))">
    <Using Include="DigitalBrain.Testing.Aspire" />
    <Using Include="DigitalBrain.OS.Testing" />
  </ItemGroup>

  <PropertyGroup>
    <CodeGraphRefresh Condition="'$(CodeGraphRefresh)' == ''">true</CodeGraphRefresh>
    <_CodeGraphRepositoryRoot>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory).'))</_CodeGraphRepositoryRoot>
    <_CodeGraphIndex>$([System.IO.Path]::Combine('$(_CodeGraphRepositoryRoot)', '.codegraph'))</_CodeGraphIndex>
    <_CodeGraphStamp>$([System.IO.Path]::Combine('$(_CodeGraphIndex)', 'msbuild-refresh.stamp'))</_CodeGraphStamp>
    <_CodeGraphCommand Condition="'$(_CodeGraphCommand)' == ''">npx -y @colbymchenry/codegraph@1.6.0</_CodeGraphCommand>
  </PropertyGroup>
</Project>
