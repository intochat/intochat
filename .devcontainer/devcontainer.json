{
  "name": "IntoChat OS Agent Dev Slot",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "USER_NAME": "agent",
      "USER_UID": "1000",
      "USER_GID": "1000",
      "FLUTTER_VERSION": "3.47.6"
    }
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "remoteUser": "agent",
  "containerUser": "agent",
  "updateRemoteUserUID": false,
  "runArgs": [
    "--security-opt=no-new-privileges:true",
    "--cap-drop=ALL",
    "--memory=2g",
    "--cpus=2",
    "--label=intochat.devslot=true"
  ],
  "containerEnv": {
    "HOME": "/home/agent",
    "XDG_CONFIG_HOME": "/home/agent/.config",
    "XDG_DATA_HOME": "/home/agent/.local/share",
    "XDG_CACHE_HOME": "/home/agent/.cache",
    "TMPDIR": "/home/agent/tmp",
    "DOTNET_CLI_HOME": "/home/agent",
    "DOTNET_NOLOGO": "true",
    "DOTNET_SKIP_FIRST_TIME_EXPERIENCE": "true",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "true",
    "PLAYWRIGHT_BROWSERS_PATH": "/opt/playwright",
    "GIT_CONFIG_NOSYSTEM": "1",
    "GIT_CONFIG_GLOBAL": "/dev/null",
    "SLOT_ID": "${localEnv:SLOT_ID:slot-00}"
  },
  "forwardPorts": [5080],
  "portsAttributes": {
    "5080": {
      "label": "IntoChat OS Candidate HTTP/MCP",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "Dart-Code.flutter"
      ]
    },
    "agentDevSlots": {
      "defaultBasePort": 5300,
      "portStride": 10,
      "composeFile": "docker-compose.slot.yml",
      "userSpec": "1000:1000",
      "containerHome": "/home/agent"
    }
  }
}
