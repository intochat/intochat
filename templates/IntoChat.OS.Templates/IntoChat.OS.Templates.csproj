<Project Sdk="Microsoft.NET.Sdk">
  <!-- Outside Intochat.OS.slnx on purpose: the pack project ships template sources, it compiles nothing. -->
  <PropertyGroup>
    <PackageId>IntoChat.OS.Templates</PackageId>
    <IsPackable>true</IsPackable>
    <PackageType>Template</PackageType>
    <Description>dotnet new templates for IntoChat OS: intochat-module scaffolds a module and its test.</Description>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128;NU5039</NoWarn>
    <LocalizeTemplates>false</LocalizeTemplates>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IncludeSymbols>false</IncludeSymbols>
    <DevelopmentDependency>true</DevelopmentDependency>
    <StampedContent>$(MSBuildProjectDirectory)/obj/stamped/</StampedContent>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="**/*" />
    <PackageReference Include="Microsoft.TemplateEngine.Authoring.Tasks" PrivateAssets="all" />
  </ItemGroup>
  <!-- Content is copied to obj/stamped with __SDK_VERSION__ replaced by the repository version, then packed from there. -->
  <Target Name="IntoChatOSStampTemplate" BeforeTargets="_GetPackageFiles;GenerateTemplateManifest;Build;Pack">
    <ItemGroup>
      <_TemplateSource Include="content/**/*" />
    </ItemGroup>
    <RemoveDir Directories="$(StampedContent)" />
    <Copy SourceFiles="@(_TemplateSource)" DestinationFiles="@(_TemplateSource->'$(StampedContent)%(RecursiveDir)%(Filename)%(Extension)')" />
    <ItemGroup>
      <_StampedFile Include="$(StampedContent)**/*" />
    </ItemGroup>
    <WriteLinesToFile File="%(_StampedFile.FullPath)"
                      Lines="$([System.IO.File]::ReadAllText('%(_StampedFile.FullPath)').Replace('__SDK_VERSION__', '$(IntoChatOSVersion)'))"
                      Overwrite="true" Encoding="UTF-8" />
    <ItemGroup>
      <Content Include="$(StampedContent)**/*" PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>
</Project>
