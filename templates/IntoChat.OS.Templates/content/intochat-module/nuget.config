<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="intochat" value="https://nuget.pkg.github.com/intochat/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="intochat">
      <package pattern="IntoChat.OS*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <intochat>
      <add key="Username" value="%NUGET_GITHUB_USERNAME%" />
      <add key="ClearTextPassword" value="%NUGET_GITHUB_TOKEN%" />
    </intochat>
  </packageSourceCredentials>
</configuration>
