{
  "$schema": "http://json.schemastore.org/template",
  "author": "Digital Brain Tech",
  "classifications": ["IntoChat", "Module"],
  "identity": "IntoChat.OS.Module.CSharp",
  "name": "IntoChat OS module",
  "description": "An IntoChat OS module with an integration, a secret, a setting and an integration test.",
  "shortName": "intochat-module",
  "tags": { "language": "C#", "type": "project" },
  "sourceName": "MODULE_NAME",
  "preferNameDirectory": true,
  "symbols": {
    "ModuleId": {
      "type": "parameter",
      "datatype": "string",
      "isRequired": true,
      "description": "Module id: ASCII letters, digits and hyphens (enforced at build by the SDK generator, IOS0002).",
      "replaces": "MODULE_ID",
      "fileRename": "MODULE_ID"
    },
    "ClassName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "safe_name",
      "replaces": "MODULE_CLASS",
      "fileRename": "MODULE_CLASS"
    },
    "Namespace": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "safe_namespace",
      "replaces": "MODULE_NAMESPACE"
    },
    "SdkVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "__SDK_VERSION__",
      "description": "IntoChat.OS.Sdk and IntoChat.OS.Testing package version.",
      "replaces": "SDK_VERSION_VALUE"
    },
    "Secret": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "ApiKey",
      "description": "Name of the module's secret.",
      "replaces": "MODULE_SECRET"
    },
    "Setting": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "Region",
      "description": "Name of the module's setting.",
      "replaces": "MODULE_SETTING"
    }
  }
}
