<Project>
  <!-- Canonical package-to-project map for opt-in ProjectReference unification.
       Import this file (and eng/IntoChat.OS.ProjectReferences.targets) from any downstream host
       repository to bind IntoChat.OS.* and DigitalBrain.* PackageReferences directly to local
       ProjectReferences without requiring lockstep NuGet package downloads during local or CI dev.
       Leave IntoChatOSUseProjectReferences unset or false (default) for standard NuGet builds. -->
  <PropertyGroup Condition="'$(_IntoChatOSProjectsPropsImported)' != 'true'">
    <_IntoChatOSProjectsPropsImported>true</_IntoChatOSProjectsPropsImported>
    <IntoChatOSRepoRoot Condition="'$(IntoChatOSRepoRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))</IntoChatOSRepoRoot>
    <IntoChatOSRepoRoot>$([MSBuild]::EnsureTrailingSlash('$(IntoChatOSRepoRoot)'))</IntoChatOSRepoRoot>
    <IntoChatOSUseProjectReferences Condition="'$(IntoChatOSUseProjectReferences)' == ''">false</IntoChatOSUseProjectReferences>
    <IntoChatOSUseProjectReferences Condition="'$(IntoChatOSUseProjectReferences)' == 'auto' And Exists('$(IntoChatOSRepoRoot)Intochat.OS.slnx')">true</IntoChatOSUseProjectReferences>
    <IntoChatOSUseProjectReferences Condition="'$(IntoChatOSUseProjectReferences)' == 'auto'">false</IntoChatOSUseProjectReferences>
  </PropertyGroup>

  <ItemGroup Condition="'@(IntoChatOSProjectMap)' == ''">
    <!-- Framework (DigitalBrain.*) -->
    <IntoChatOSProjectMap Include="DigitalBrain" ProjectPath="$(IntoChatOSRepoRoot)framework/src/DigitalBrain/DigitalBrain.csproj" IsAnalyzer="false" />
    <IntoChatOSProjectMap Include="DigitalBrain.Analyzers" ProjectPath="$(IntoChatOSRepoRoot)framework/src/DigitalBrain.Analyzers/DigitalBrain.Analyzers.csproj" IsAnalyzer="true" />
    <IntoChatOSProjectMap Include="DigitalBrain.Runtime.Http" ProjectPath="$(IntoChatOSRepoRoot)framework/src/DigitalBrain.Runtime.Http/DigitalBrain.Runtime.Http.csproj" IsAnalyzer="false" />
    <IntoChatOSProjectMap Include="DigitalBrain.Runtime.Orleans" ProjectPath="$(IntoChatOSRepoRoot)framework/src/DigitalBrain.Runtime.Orleans/DigitalBrain.Runtime.Orleans.csproj" IsAnalyzer="false" />
    <IntoChatOSProjectMap Include="DigitalBrain.Runtime.Orleans.Azure" ProjectPath="$(IntoChatOSRepoRoot)framework/src/DigitalBrain.Runtime.Orleans.Azure/DigitalBrain.Runtime.Orleans.Azure.csproj" IsAnalyzer="false" />
    <IntoChatOSProjectMap Include="DigitalBrain.Simulation" ProjectPath="$(IntoChatOSRepoRoot)framework/src/DigitalBrain.Simulation/DigitalBrain.Simulation.csproj" IsAnalyzer="false" />
    <IntoChatOSProjectMap Include="DigitalBrain.Testing" ProjectPath="$(IntoChatOSRepoRoot)framework/src/DigitalBrain.Testing/DigitalBrain.Testing.csproj" IsAnalyzer="false" />
    <IntoChatOSProjectMap Include="DigitalBrain.Testing.Silo" ProjectPath="$(IntoChatOSRepoRoot)framework/src/DigitalBrain.Testing.Silo/DigitalBrain.Testing.Silo.csproj" IsAnalyzer="false" />

    <!-- OS Core (IntoChat.OS.*) -->
    <IntoChatOSProjectMap Include="IntoChat.OS" ProjectPath="$(IntoChatOSRepoRoot)src/IntoChat.OS/IntoChat.OS.csproj" IsAnalyzer="false" />
    <IntoChatOSProjectMap Include="IntoChat.OS.AppHost" ProjectPath="$(IntoChatOSRepoRoot)src/IntoChat.OS.AppHost/IntoChat.OS.AppHost.csproj" IsAnalyzer="false" />
    <IntoChatOSProjectMap Include="IntoChat.OS.Apps" ProjectPath="$(IntoChatOSRepoRoot)src/IntoChat.OS.Apps/IntoChat.OS.Apps.csproj" IsAnalyzer="false" />
    <IntoChatOSProjectMap Include="IntoChat.OS.Contracts" ProjectPath="$(IntoChatOSRepoRoot)src/IntoChat.OS.Contracts/IntoChat.OS.Contracts.csproj" IsAnalyzer="false" />
    <IntoChatOSProjectMap Include="IntoChat.OS.Host" ProjectPath="$(IntoChatOSRepoRoot)src/IntoChat.OS.Host/IntoChat.OS.Host.csproj" IsAnalyzer="false" />
    <IntoChatOSProjectMap Include="IntoChat.OS.Kernel" ProjectPath="$(IntoChatOSRepoRoot)src/IntoChat.OS.Kernel/IntoChat.OS.Kernel.csproj" IsAnalyzer="false" />
    <IntoChatOSProjectMap Include="IntoChat.OS.LocalSetup" ProjectPath="$(IntoChatOSRepoRoot)src/IntoChat.OS.LocalSetup/IntoChat.OS.LocalSetup.csproj" IsAnalyzer="false" />
    <IntoChatOSProjectMap Include="IntoChat.OS.UI" ProjectPath="$(IntoChatOSRepoRoot)src/IntoChat.OS.UI/IntoChat.OS.UI.csproj" IsAnalyzer="false" />

    <!-- Components (IntoChat.OS.Components.*) -->
    <IntoChatOSProjectMap Include="IntoChat.OS.Components.Aspire" ProjectPath="$(IntoChatOSRepoRoot)src/Components/Aspire/IntoChat.Aspire.csproj" IsAnalyzer="false" />

    <!-- Modules (IntoChat.OS.Modules.*) -->
    <IntoChatOSProjectMap Include="IntoChat.OS.Modules.AI" ProjectPath="$(IntoChatOSRepoRoot)src/Modules/AI/IntoChat.OS.Modules.AI.csproj" IsAnalyzer="false" />
    <IntoChatOSProjectMap Include="IntoChat.OS.Modules.Catalog" ProjectPath="$(IntoChatOSRepoRoot)src/Modules/Catalog/IntoChat.OS.Modules.Catalog.csproj" IsAnalyzer="false" />
    <IntoChatOSProjectMap Include="IntoChat.OS.Modules.Devices" ProjectPath="$(IntoChatOSRepoRoot)src/Modules/Devices/IntoChat.OS.Modules.Devices.csproj" IsAnalyzer="false" />
    <IntoChatOSProjectMap Include="IntoChat.OS.Modules.Identity" ProjectPath="$(IntoChatOSRepoRoot)src/Modules/Identity/IntoChat.OS.Modules.Identity.csproj" IsAnalyzer="false" />
    <IntoChatOSProjectMap Include="IntoChat.OS.Modules.Identity.Contracts" ProjectPath="$(IntoChatOSRepoRoot)src/Modules/Identity/Contracts/IntoChat.OS.Modules.Identity.Contracts.csproj" IsAnalyzer="false" />
    <IntoChatOSProjectMap Include="IntoChat.OS.Modules.Infrastructure" ProjectPath="$(IntoChatOSRepoRoot)src/Modules/Infrastructure/IntoChat.OS.Modules.Infrastructure.csproj" IsAnalyzer="false" />
    <IntoChatOSProjectMap Include="IntoChat.OS.Modules.Plugins" ProjectPath="$(IntoChatOSRepoRoot)src/Modules/Plugins/IntoChat.OS.Modules.Plugins.csproj" IsAnalyzer="false" />
    <IntoChatOSProjectMap Include="IntoChat.OS.Modules.Roslyn" ProjectPath="$(IntoChatOSRepoRoot)src/Modules/Roslyn/IntoChat.OS.Modules.Roslyn.csproj" IsAnalyzer="false" />
    <IntoChatOSProjectMap Include="IntoChat.OS.Modules.Shell" ProjectPath="$(IntoChatOSRepoRoot)src/Modules/Shell/IntoChat.OS.Modules.Shell.csproj" IsAnalyzer="false" />
    <IntoChatOSProjectMap Include="IntoChat.OS.Modules.UI" ProjectPath="$(IntoChatOSRepoRoot)src/Modules/UI/IntoChat.OS.Modules.UI.csproj" IsAnalyzer="false" />
  </ItemGroup>
</Project>
