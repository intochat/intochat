<Project>
  <!-- Runs after SDK/package props. Keep CI solution builds framework-dependent / portable. -->
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <RuntimeIdentifier></RuntimeIdentifier>
    <EnableSdkContainerSupport>false</EnableSdkContainerSupport>
  </PropertyGroup>

  <!-- IsPackable is false in Directory.Build.props and projects opt in from their own body,
       which imports later. Evaluating the pack items there always saw false, so the declared
       README and icon were never packed and pack failed with NU5039. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <!-- No Exists guard: a missing icon must fail the pack (NU5039), not silently ship without it. -->
    <None Include="$(MSBuildThisFileDirectory)src/Assets/nuget/icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <PackageReference Include="DigitalBrain.Analyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <PropertyGroup Condition="'$(IntoChatOSOnlyTier)' != '' And '$(IntoChatOSTestTier)' != '' And '$(IntoChatOSTestTier)' != '$(IntoChatOSOnlyTier)'">
    <RunAnalyzers>false</RunAnalyzers>
    <OrleansGenerateCode>false</OrleansGenerateCode>
  </PropertyGroup>
  <ItemGroup Condition="'$(IntoChatOSOnlyTier)' != '' And '$(IntoChatOSTestTier)' != '' And '$(IntoChatOSTestTier)' != '$(IntoChatOSOnlyTier)'">
    <Compile Remove="*.cs;**/*.cs" />
    <ProjectReference Remove="@(ProjectReference)" />
  </ItemGroup>

  <!-- Pinned to CodeGraph 1.6.0 in Directory.Build.props until the Windows fix ships:
       https://github.com/colbymchenry/codegraph/issues/2094 -->
  <Target Name="RefreshCodeGraph"
          BeforeTargets="BeforeBuild"
          Inputs="@(Compile);$(MSBuildProjectFullPath)"
          Outputs="$(_CodeGraphStamp)"
          Condition="'$(DesignTimeBuild)' != 'true' And '$(MSBuildProjectExtension)' == '.csproj' And '$(CI)' != 'true' And '$(CodeGraphRefresh)' != 'false'">
    <PropertyGroup>
      <_CodeGraphIndexExists>$([System.IO.Directory]::Exists('$(_CodeGraphIndex)'))</_CodeGraphIndexExists>
    </PropertyGroup>
    <Exec Command="$(_CodeGraphCommand) init &quot;$(_CodeGraphRepositoryRoot)&quot;"
          WorkingDirectory="$(_CodeGraphRepositoryRoot)"
          Condition="'$(_CodeGraphIndexExists)' != 'True'"
          IgnoreStandardErrorWarningFormat="true"
          ContinueOnError="WarnAndContinue">
      <Output TaskParameter="ExitCode" PropertyName="_CodeGraphExitCode" />
    </Exec>
    <Exec Command="$(_CodeGraphCommand) sync --quiet &quot;$(_CodeGraphRepositoryRoot)&quot;"
          WorkingDirectory="$(_CodeGraphRepositoryRoot)"
          Condition="'$(_CodeGraphIndexExists)' == 'True'"
          IgnoreStandardErrorWarningFormat="true"
          ContinueOnError="WarnAndContinue">
      <Output TaskParameter="ExitCode" PropertyName="_CodeGraphExitCode" />
    </Exec>
    <Touch Files="$(_CodeGraphStamp)" AlwaysCreate="true" Condition="'$(_CodeGraphExitCode)' == '0'" />
  </Target>
</Project>
