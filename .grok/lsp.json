{
  "csharp": {
    "command": "csharp-ls",
    "args": ["--solution", "Intochat.OS.slnx", "--loglevel", "warning"],
    "extensionToLanguage": {
      ".cs": "csharp"
    },
    "startupTimeout": 120000
  },
  "dart": {
    "command": "dart",
    "args": ["language-server", "--protocol=lsp"],
    "extensionToLanguage": {
      ".dart": "dart"
    },
    "workspaceFolder": "src/IntoChat.OS.Modules/Google/Flutter/app",
    "initializationOptions": {
      "onlyAnalyzeProjectsWithOpenFiles": true
    },
    "startupTimeout": 120000
  }
}
