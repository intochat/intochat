<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <RootNamespace>DigitalBrain.Testing</RootNamespace>
    <PackageId>DigitalBrain.Simulation</PackageId>
    <Description>Deterministic simulator (TestOS) and Roslyn synapse compiler/collectible loader. No test framework, no Orleans.</Description>
    <DefineConstants Condition="'$(IntoChatOSAot)' == 'true'">$(DefineConstants);INTOCHAT_OS_AOT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="DigitalBrain.ReplacesAssembly" Value="DigitalBrain.Runtime.Synapses" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../DigitalBrain/DigitalBrain.csproj" />
    <!-- DigitalBrain.Analyzers packs analyzer-only (no lib/), so it is no package dependency: its dll ships in this package's lib/. -->
    <ProjectReference Include="../DigitalBrain.Analyzers/DigitalBrain.Analyzers.csproj" ReferenceOutputAssembly="true" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <None Include="$(OutDir)DigitalBrain.Analyzers.dll" Pack="true" PackagePath="lib/$(TargetFramework)/" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DigitalBrain.Testing" />
    <InternalsVisibleTo Include="DigitalBrain.Testing.Silo" />
    <InternalsVisibleTo Include="DigitalBrain.Tests.Unit" />
    <InternalsVisibleTo Include="DigitalBrain.Framework.Tests.E2E" />
    <InternalsVisibleTo Include="DigitalBrain.Architecture.Tests.Unit" />
  </ItemGroup>
</Project>
