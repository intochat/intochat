<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <AspireVersion>17.1.0-preview.1.26573.9</AspireVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pin patched transitive dependencies; keep NuGet auditing enabled.
         MessagePack 2.5.302 is NU1902 (GHSA-qhrr-8q5h-9q3h); 2.5.307+ is the patched 2.x release. -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <PackageVersion Include="Octokit" Version="14.0.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.4.0" />
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageVersion Include="Grpc.AspNetCore.Web" Version="2.84.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="17.11.48" />
    <PackageVersion Include="Microsoft.NET.StringTools" Version="18.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting" Version="17.1.0-preview.1.26573.9" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.1.0-preview.1.26573.9" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.1.0-preview.1.26573.9" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="17.1.0-preview.1.26573.9" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="17.1.0-preview.1.26573.9" />
    <PackageVersion Include="Aspire.Hosting.Orleans" Version="17.1.0-preview.1.26573.9" />
    <PackageVersion Include="Aspire.Hosting.Yarp" Version="17.1.0-preview.1.26573.9" />
    <PackageVersion Include="Aspire.Hosting.ClickHouse" Version="13.5.3" />
    <PackageVersion Include="Aspire.Azure.Data.Tables" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Azure.Storage.Blobs" Version="$(AspireVersion)" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageVersion Include="Azure.Storage.Queues" Version="12.28.1" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageVersion Include="ClickHouse.Driver" Version="1.5.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Ollama" Version="17.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.CommandLine" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="QRCoder" Version="1.8.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.11.2" />
    <PackageVersion Include="Azure.ResourceManager" Version="1.14.0" />
    <PackageVersion Include="Azure.ResourceManager.AppContainers" Version="1.6.0" />
    <PackageVersion Include="Azure.ResourceManager.Authorization" Version="1.1.7" />
    <PackageVersion Include="Azure.ResourceManager.KeyVault" Version="1.5.0" />
    <PackageVersion Include="Azure.ResourceManager.ManagedServiceIdentities" Version="1.4.1" />
    <PackageVersion Include="Azure.ResourceManager.Network" Version="1.17.0" />
    <PackageVersion Include="Azure.ResourceManager.OperationalInsights" Version="1.4.0" />
    <PackageVersion Include="Azure.ResourceManager.ContainerRegistry" Version="1.4.0" />
    <PackageVersion Include="Azure.ResourceManager.PostgreSql" Version="1.4.2" />
    <PackageVersion Include="Azure.ResourceManager.Resources" Version="1.12.0" />
    <PackageVersion Include="Azure.ResourceManager.Storage" Version="1.8.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageVersion Include="Anthropic" Version="13.9.0" />
    <PackageVersion Include="OpenAI" Version="2.14.0" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.28.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" Version="1.28.0-preview.261106.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.28.0" />
    <PackageVersion Include="Microsoft.Agents.AI.DevUI" Version="1.28.0-preview.261106.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting" Version="1.28.0-preview.261106.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.OpenAI" Version="1.28.0-alpha.261106.1" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageVersion Include="OllamaSharp" Version="5.5.0" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <PackageVersion Include="Microsoft.Orleans.Client" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Orleans.Clustering.AzureStorage" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Orleans.Persistence.AzureStorage" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Orleans.Reminders.AzureStorage" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Orleans.Dashboard" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Orleans.Reminders" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Orleans.Sdk" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Orleans.Server" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Orleans.Serialization.SystemTextJson" Version="10.4.0" />
    <PackageVersion Include="Microsoft.AI.Foundry.Local" Version="2.5.0" />
    <PackageVersion Include="org.k2fsa.sherpa.onnx" Version="2.0.1" />
    <PackageVersion Include="Concentus" Version="2.2.2" />
    <PackageVersion Include="Concentus.Oggfile" Version="1.0.7" />
    <PackageVersion Include="NAudio" Version="3.3.0" />
    <PackageVersion Include="MimeKit" Version="4.18.2" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.4" />
    <PackageVersion Include="CsCheck" Version="5.0.1" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.2" />
    <PackageVersion Include="Microsoft.TemplateEngine.Authoring.Tasks" Version="11.0.100-rc.1.26425.128" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.assert" Version="4.0.2" />
    <!-- Restored, never referenced for assemblies: hosted tests read DCP and dashboard paths
         out of these packages because they build the Aspire model without an AppHost project. -->
    <PackageVersion Include="Aspire.Hosting.Orchestration.win-x64" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Orchestration.linux-x64" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Orchestration.linux-arm64" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Orchestration.osx-arm64" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Orchestration.osx-x64" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Dashboard.Sdk.win-x64" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Dashboard.Sdk.linux-x64" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Dashboard.Sdk.linux-arm64" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Dashboard.Sdk.osx-arm64" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Dashboard.Sdk.osx-x64" Version="$(AspireVersion)" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Orleans.Core.Abstractions" Version="10.4.0" />
  </ItemGroup>
</Project>
